START -> STATEMENT

STATEMENT -> SIMPLE_STATEMENT ; | ;
SIMPLE_STATEMENT -> DECLARATION | EXPRESSION
SIMPLE_STATEMENT -> return | return EXPRESSION
SIMPLE_STATEMENT -> co_return | co_return EXPRESSION
SIMPLE_STATEMENT -> throw | break | continue

DECLARATION -> TYPE_SPECIFIER INIT_DECLARATOR_LIST
DECLARATION -> DECLARATION_PREFIX TYPE_SPECIFIER INIT_DECLARATOR_LIST
DECLARATION_PREFIX -> static | extern | thread_local | mutable
DECLARATION_PREFIX -> constexpr | consteval | constinit | inline
DECLARATION_PREFIX -> static constexpr | constexpr static
DECLARATION_PREFIX -> extern thread_local | thread_local extern
DECLARATION_PREFIX -> static thread_local | thread_local static

INIT_DECLARATOR_LIST -> INIT_DECLARATOR | INIT_DECLARATOR_LIST , INIT_DECLARATOR
INIT_DECLARATOR -> DECLARATOR
INIT_DECLARATOR -> DECLARATOR = INITIALIZER_CLAUSE
INIT_DECLARATOR -> DECLARATOR BRACED_INIT_LIST
INIT_DECLARATOR -> DECLARATOR ( ) | DECLARATOR ( ARGUMENT_LIST )

DECLARATOR -> DECLARATOR_CORE | DECLARATOR_CORE ARRAY_DECLARATOR_SUFFIX
DECLARATOR_CORE -> IDENTIFIER | POINTER_PREFIX IDENTIFIER
DECLARATOR_CORE -> & IDENTIFIER | && IDENTIFIER
DECLARATOR_CORE -> POINTER_PREFIX & IDENTIFIER | POINTER_PREFIX && IDENTIFIER
POINTER_PREFIX -> POINTER_ATOM | POINTER_PREFIX POINTER_ATOM
POINTER_ATOM -> * | * const | * volatile | * const volatile | * volatile const
ARRAY_DECLARATOR_SUFFIX -> [ ] | [ ASSIGNMENT_EXPRESSION ]
ARRAY_DECLARATOR_SUFFIX -> ARRAY_DECLARATOR_SUFFIX [ ]
ARRAY_DECLARATOR_SUFFIX -> ARRAY_DECLARATOR_SUFFIX [ ASSIGNMENT_EXPRESSION ]

TYPE_ID -> TYPE_SPECIFIER | TYPE_SPECIFIER ABSTRACT_DECLARATOR
ABSTRACT_DECLARATOR -> POINTER_PREFIX | & | &&
ABSTRACT_DECLARATOR -> POINTER_PREFIX & | POINTER_PREFIX &&
ABSTRACT_DECLARATOR -> ARRAY_DECLARATOR_SUFFIX | POINTER_PREFIX ARRAY_DECLARATOR_SUFFIX

TYPE_SPECIFIER -> BASE_TYPE
TYPE_SPECIFIER -> const BASE_TYPE | BASE_TYPE const
TYPE_SPECIFIER -> volatile BASE_TYPE | BASE_TYPE volatile
TYPE_SPECIFIER -> const volatile BASE_TYPE | volatile const BASE_TYPE
TYPE_SPECIFIER -> BASE_TYPE const volatile | BASE_TYPE volatile const

BASE_TYPE -> BUILTIN_TYPE | QUALIFIED_TYPE
BASE_TYPE -> decltype ( EXPRESSION ) | decltype ( auto )
BASE_TYPE -> typename QUALIFIED_TYPE

BUILTIN_TYPE -> void | bool
BUILTIN_TYPE -> char | signed char | unsigned char
BUILTIN_TYPE -> wchar_t | char8_t | char16_t | char32_t
BUILTIN_TYPE -> short | short int | signed short | signed short int
BUILTIN_TYPE -> unsigned short | unsigned short int
BUILTIN_TYPE -> int | signed | signed int | unsigned | unsigned int
BUILTIN_TYPE -> long | long int | signed long | signed long int
BUILTIN_TYPE -> unsigned long | unsigned long int
BUILTIN_TYPE -> long long | long long int | signed long long | signed long long int
BUILTIN_TYPE -> unsigned long long | unsigned long long int
BUILTIN_TYPE -> float | double | long double | auto

QUALIFIED_TYPE -> TYPE_NAME | :: TYPE_NAME
TYPE_NAME -> NAME_COMPONENT | TYPE_NAME :: NAME_COMPONENT
TYPE_NAME -> TYPE_NAME :: template NAME_COMPONENT
NAME_COMPONENT -> IDENTIFIER | IDENTIFIER < TEMPLATE_ARGUMENT_LIST >

TEMPLATE_ARGUMENT_LIST -> TEMPLATE_ARGUMENT
TEMPLATE_ARGUMENT_LIST -> TEMPLATE_ARGUMENT_LIST , TEMPLATE_ARGUMENT
TEMPLATE_ARGUMENT -> TYPE_ID | ASSIGNMENT_EXPRESSION
TEMPLATE_ARGUMENT -> TYPE_ID ... | ASSIGNMENT_EXPRESSION ...

EXPRESSION -> ASSIGNMENT_EXPRESSION | EXPRESSION , ASSIGNMENT_EXPRESSION

ASSIGNMENT_EXPRESSION -> CONDITIONAL_EXPRESSION
ASSIGNMENT_EXPRESSION -> UNARY_EXPRESSION ASSIGNMENT_OPERATOR ASSIGNMENT_EXPRESSION
ASSIGNMENT_EXPRESSION -> throw ASSIGNMENT_EXPRESSION | co_yield ASSIGNMENT_EXPRESSION
ASSIGNMENT_OPERATOR -> = | *= | /= | %= | += | -=
ASSIGNMENT_OPERATOR -> <<= | >>= | &= | ^= | `|=`

CONDITIONAL_EXPRESSION -> LOGICAL_OR_EXPRESSION
CONDITIONAL_EXPRESSION -> LOGICAL_OR_EXPRESSION ? EXPRESSION : ASSIGNMENT_EXPRESSION

LOGICAL_OR_EXPRESSION -> LOGICAL_AND_EXPRESSION
LOGICAL_OR_EXPRESSION -> LOGICAL_OR_EXPRESSION `||` LOGICAL_AND_EXPRESSION
LOGICAL_AND_EXPRESSION -> INCLUSIVE_OR_EXPRESSION
LOGICAL_AND_EXPRESSION -> LOGICAL_AND_EXPRESSION && INCLUSIVE_OR_EXPRESSION

INCLUSIVE_OR_EXPRESSION -> EXCLUSIVE_OR_EXPRESSION
INCLUSIVE_OR_EXPRESSION -> INCLUSIVE_OR_EXPRESSION `|` EXCLUSIVE_OR_EXPRESSION
EXCLUSIVE_OR_EXPRESSION -> AND_EXPRESSION
EXCLUSIVE_OR_EXPRESSION -> EXCLUSIVE_OR_EXPRESSION ^ AND_EXPRESSION
AND_EXPRESSION -> EQUALITY_EXPRESSION
AND_EXPRESSION -> AND_EXPRESSION & EQUALITY_EXPRESSION

EQUALITY_EXPRESSION -> RELATIONAL_EXPRESSION
EQUALITY_EXPRESSION -> EQUALITY_EXPRESSION == RELATIONAL_EXPRESSION
EQUALITY_EXPRESSION -> EQUALITY_EXPRESSION != RELATIONAL_EXPRESSION
RELATIONAL_EXPRESSION -> THREE_WAY_EXPRESSION
RELATIONAL_EXPRESSION -> RELATIONAL_EXPRESSION < THREE_WAY_EXPRESSION
RELATIONAL_EXPRESSION -> RELATIONAL_EXPRESSION > THREE_WAY_EXPRESSION
RELATIONAL_EXPRESSION -> RELATIONAL_EXPRESSION <= THREE_WAY_EXPRESSION
RELATIONAL_EXPRESSION -> RELATIONAL_EXPRESSION >= THREE_WAY_EXPRESSION
THREE_WAY_EXPRESSION -> SHIFT_EXPRESSION
THREE_WAY_EXPRESSION -> THREE_WAY_EXPRESSION <=> SHIFT_EXPRESSION

SHIFT_EXPRESSION -> ADDITIVE_EXPRESSION
SHIFT_EXPRESSION -> SHIFT_EXPRESSION << ADDITIVE_EXPRESSION
SHIFT_EXPRESSION -> SHIFT_EXPRESSION >> ADDITIVE_EXPRESSION
ADDITIVE_EXPRESSION -> MULTIPLICATIVE_EXPRESSION
ADDITIVE_EXPRESSION -> ADDITIVE_EXPRESSION + MULTIPLICATIVE_EXPRESSION
ADDITIVE_EXPRESSION -> ADDITIVE_EXPRESSION - MULTIPLICATIVE_EXPRESSION
MULTIPLICATIVE_EXPRESSION -> POINTER_MEMBER_EXPRESSION
MULTIPLICATIVE_EXPRESSION -> MULTIPLICATIVE_EXPRESSION * POINTER_MEMBER_EXPRESSION
MULTIPLICATIVE_EXPRESSION -> MULTIPLICATIVE_EXPRESSION / POINTER_MEMBER_EXPRESSION
MULTIPLICATIVE_EXPRESSION -> MULTIPLICATIVE_EXPRESSION % POINTER_MEMBER_EXPRESSION
POINTER_MEMBER_EXPRESSION -> CAST_EXPRESSION
POINTER_MEMBER_EXPRESSION -> POINTER_MEMBER_EXPRESSION .* CAST_EXPRESSION
POINTER_MEMBER_EXPRESSION -> POINTER_MEMBER_EXPRESSION `->*` CAST_EXPRESSION

CAST_EXPRESSION -> UNARY_EXPRESSION | ( TYPE_ID ) CAST_EXPRESSION
UNARY_EXPRESSION -> POSTFIX_EXPRESSION
UNARY_EXPRESSION -> PREFIX_OPERATOR CAST_EXPRESSION
UNARY_EXPRESSION -> SIZEOF_EXPRESSION | ALIGNOF_EXPRESSION
UNARY_EXPRESSION -> NAMED_CAST_EXPRESSION | NEW_EXPRESSION | DELETE_EXPRESSION
UNARY_EXPRESSION -> noexcept ( EXPRESSION ) | TYPEID_EXPRESSION
PREFIX_OPERATOR -> ++ | -- | + | - | ! | ~ | * | & | co_await

SIZEOF_EXPRESSION -> sizeof UNARY_EXPRESSION | sizeof ( TYPE_ID )
SIZEOF_EXPRESSION -> sizeof ... ( IDENTIFIER )
ALIGNOF_EXPRESSION -> alignof ( TYPE_ID )
TYPEID_EXPRESSION -> typeid ( EXPRESSION ) | typeid ( TYPE_ID )

NAMED_CAST_EXPRESSION -> static_cast < TYPE_ID > ( EXPRESSION )
NAMED_CAST_EXPRESSION -> dynamic_cast < TYPE_ID > ( EXPRESSION )
NAMED_CAST_EXPRESSION -> reinterpret_cast < TYPE_ID > ( EXPRESSION )
NAMED_CAST_EXPRESSION -> const_cast < TYPE_ID > ( EXPRESSION )

NEW_EXPRESSION -> new NEW_TYPE | new NEW_TYPE NEW_INITIALIZER
NEW_EXPRESSION -> :: new NEW_TYPE | :: new NEW_TYPE NEW_INITIALIZER
NEW_EXPRESSION -> new ( ARGUMENT_LIST ) NEW_TYPE
NEW_EXPRESSION -> new ( ARGUMENT_LIST ) NEW_TYPE NEW_INITIALIZER
NEW_EXPRESSION -> :: new ( ARGUMENT_LIST ) NEW_TYPE
NEW_EXPRESSION -> :: new ( ARGUMENT_LIST ) NEW_TYPE NEW_INITIALIZER
NEW_TYPE -> TYPE_ID | TYPE_ID NEW_ARRAY_SUFFIX
NEW_ARRAY_SUFFIX -> [ ASSIGNMENT_EXPRESSION ]
NEW_ARRAY_SUFFIX -> NEW_ARRAY_SUFFIX [ ASSIGNMENT_EXPRESSION ]
NEW_INITIALIZER -> ( ) | ( ARGUMENT_LIST ) | BRACED_INIT_LIST

DELETE_EXPRESSION -> delete CAST_EXPRESSION | delete [ ] CAST_EXPRESSION
DELETE_EXPRESSION -> :: delete CAST_EXPRESSION | :: delete [ ] CAST_EXPRESSION

POSTFIX_EXPRESSION -> PRIMARY_EXPRESSION
POSTFIX_EXPRESSION -> POSTFIX_EXPRESSION POSTFIX_SUFFIX
POSTFIX_SUFFIX -> ( ) | ( ARGUMENT_LIST ) | [ EXPRESSION ]
POSTFIX_SUFFIX -> . NAME_COMPONENT | `->` NAME_COMPONENT
POSTFIX_SUFFIX -> . template NAME_COMPONENT | `->` template NAME_COMPONENT
POSTFIX_SUFFIX -> ++ | --

PRIMARY_EXPRESSION -> QUALIFIED_NAME | LITERAL | this
PRIMARY_EXPRESSION -> ( EXPRESSION )
PRIMARY_EXPRESSION -> QUALIFIED_NAME BRACED_INIT_LIST
QUALIFIED_NAME -> TYPE_NAME | :: TYPE_NAME

ARGUMENT_LIST -> INITIALIZER_CLAUSE
ARGUMENT_LIST -> ARGUMENT_LIST , INITIALIZER_CLAUSE
INITIALIZER_CLAUSE -> ASSIGNMENT_EXPRESSION | BRACED_INIT_LIST
BRACED_INIT_LIST -> { } | { INITIALIZER_LIST } | { INITIALIZER_LIST , }
INITIALIZER_LIST -> INITIALIZER_CLAUSE
INITIALIZER_LIST -> INITIALIZER_LIST , INITIALIZER_CLAUSE

LITERAL -> @integer | @floating | @character | @string
LITERAL -> @boolean | @nullptr
IDENTIFIER -> @fresh
