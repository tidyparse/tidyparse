+bool isMacroSafeSemanticSymbol(const SemanticCompletionSymbol &Symbol,
+                               Preprocessor &PP) {
+  auto Unsafe = [&](llvm::StringRef Spelling) {
+    return !Spelling.empty() && containsActiveMacroIdentifier(Spelling, PP);
