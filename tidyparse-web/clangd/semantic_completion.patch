+  for (RawLexer.LexFromRawLexer(Tok); !Tok.is(tok::eof);
+       RawLexer.LexFromRawLexer(Tok)) {
+    if (Tok.is(tok::unknown))
+      return true;
+    if (!Tok.is(tok::raw_identifier))
+      continue;
+    IdentifierInfo *Identifier = PP.LookUpIdentifierInfo(Tok);
+    if (!Identifier)
