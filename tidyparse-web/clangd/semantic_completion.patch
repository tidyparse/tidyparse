+llvm::json::Object
+semanticTypeProfileJSON(const SemanticCompletionTypeProfile &P) {
+  llvm::json::Object Result{{"type", P.Type},
+                            {"canonicalType", P.CanonicalType}};
+  if (P.TypeInfo.Present)
+    Result["typeInfo"] = semanticTypeInfoJSON(P.TypeInfo);
+  return Result;
+}
+
+llvm::json::Object semanticTemplateArgumentProfileJSON(
+    const SemanticCompletionTemplateArgumentProfile &P) {
+  llvm::json::Object Result{{"kind", P.Kind},
+                            {"type", semanticTypeProfileJSON(P.Type)}};
+  if (!P.Spelling.empty())
+    Result["spelling"] = P.Spelling;
+  if (!P.CanonicalValue.empty())
+    Result["canonicalValue"] = P.CanonicalValue;
+  return Result;
+}
