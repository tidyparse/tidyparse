+void ClangdLSPServer::onSemanticCompletion(
+    const SemanticCompletionParams &Params,
+    Callback<llvm::json::Value> Reply) {
+  auto CompletionOpts = Opts.CodeComplete;
+  CompletionOpts.ForceLoadPreamble = true;
+  CompletionOpts.IncludeSemanticDetails = true;
+  CompletionOpts.PreserveRequestConfiguration = true;
+  CompletionOpts.BundleOverloads = false;
+  CompletionOpts.EnableSnippets = false;
+  CompletionOpts.CodePatterns = Config::CodePatternsPolicy::None;
+  CompletionOpts.IncludeIneligibleResults = false;
+  // Compute (but never return) include edits so unavailable index-only symbols
+  // can be excluded even when clangd was launched with --header-insertion=never.
+  CompletionOpts.InsertIncludes = Config::HeaderInsertionPolicy::IWYU;
+  CompletionOpts.AllScopes = Params.allScopes.value_or(false);
+  CompletionOpts.RunParser = CodeCompleteOptions::AlwaysParse;
+  if (Params.limit && *Params.limit >= 0)
+    CompletionOpts.Limit = *Params.limit;
+  const size_t GraphLimit =
+      Params.graphLimit && *Params.graphLimit > 0 ? *Params.graphLimit : 0;
+  const unsigned GraphDepth = GraphLimit
+                                  ? static_cast<unsigned>(
+                                        Params.graphDepth &&
+                                                *Params.graphDepth >= 0
+                                            ? *Params.graphDepth
+                                            : 2)
+                                  : 0;
+  const size_t OperationLimit = Params.operationLimit &&
+                                        *Params.operationLimit > 0
+                                    ? *Params.operationLimit
+                                    : 0;
+  const unsigned OperationDepth =
+      OperationLimit
+          ? static_cast<unsigned>(Params.operationDepth &&
+                                          *Params.operationDepth >= 0
+                                      ? *Params.operationDepth
+                                      : 2)
+          : 0;
+  const size_t ExpressionWitnessLimit =
+      Params.expressionWitnessLimit && *Params.expressionWitnessLimit > 0
+          ? *Params.expressionWitnessLimit
+          : 0;
+  const size_t CallWitnessLimit =
+      Params.callWitnessLimit && *Params.callWitnessLimit > 0
+          ? *Params.callWitnessLimit
+          : 0;
+  const unsigned CallWitnessMaxArity =
+      CallWitnessLimit && Params.callWitnessMaxArity &&
+              *Params.callWitnessMaxArity > 0
+          ? static_cast<unsigned>(*Params.callWitnessMaxArity)
+          : 0;
+  std::string File = Params.textDocument.uri.file().str();
+  Server->codeComplete(
+      File, Params.position, CompletionOpts,
+      [this, File = std::move(File), ScopePosition = Params.scopePosition,
+       CompletionOpts, GraphLimit, GraphDepth, OperationLimit, OperationDepth,
+       ExpressionWitnessLimit, CallWitnessLimit, CallWitnessMaxArity,
+       Reply = std::move(Reply)](
+          llvm::Expected<CodeCompleteResult> Primary) mutable {
+        if (!Primary)
+          return Reply(Primary.takeError());
+        if (!ScopePosition)
+          return Reply(semanticCompletionJSON(*Primary));
+        auto ScopeOpts = CompletionOpts;
+        // This pass inventories declarations visible at the statement, not
+        // fuzzy matches from unrelated scopes. The primary query above owns
+        // index/all-scopes lookup for the actual completion cursor.
+        // This pass is the synchronous semantic inventory. Without external
+        // AST loading, qualified lookup sees only declarations that happen to
+        // have been deserialized while parsing the main file, making the graph
+        // depend on asynchronous index warm-up and prior requests.
+        ScopeOpts.ForceLoadPreamble = true;
+        ScopeOpts.AllScopes = false;
+        ScopeOpts.IncludeAllSemaDeclarations = true;
+        ScopeOpts.SemanticGraphLimit = GraphLimit;
+        ScopeOpts.SemanticGraphDepth = GraphDepth;
+        ScopeOpts.SemanticOperationLimit = OperationLimit;
+        ScopeOpts.SemanticOperationDepth = OperationDepth;
+        ScopeOpts.SemanticExpressionWitnessLimit = ExpressionWitnessLimit;
+        ScopeOpts.SemanticCallWitnessLimit = CallWitnessLimit;
+        ScopeOpts.SemanticCallWitnessMaxArity = CallWitnessMaxArity;
+        Server->codeComplete(
+            File, *ScopePosition, ScopeOpts,
+            [Primary = std::move(*Primary), Reply = std::move(Reply)](
+                llvm::Expected<CodeCompleteResult> Scope) mutable {
+              if (!Scope)
+                return Reply(semanticCompletionJSON(Primary));
+              return Reply(semanticCompletionJSON(Primary, &*Scope));
+            });
+      });
+}
