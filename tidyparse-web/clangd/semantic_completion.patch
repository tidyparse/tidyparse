+llvm::json::Object semanticSymbolJSON(const SemanticCompletionSymbol &S) {
+  llvm::json::Array Parameters;
+  for (const auto &P : S.Parameters) {
+    llvm::json::Object Param{{"name", P.Name},
+                             {"type", P.Type},
+                             {"canonicalType", P.CanonicalType},
+                             {"hasDefault", P.HasDefault},
+                             {"isPack", P.IsPack},
+                             {"isForwardingReference",
+                              P.IsForwardingReference},
+                             {"templateOccurrences",
+                              semanticTemplateOccurrencesJSON(
+                                  P.TemplateOccurrences)}};
+    if (P.TypeInfo.Present)
+      Param["typeInfo"] = semanticTypeInfoJSON(P.TypeInfo);
+    Parameters.push_back(std::move(Param));
+  }
+  llvm::json::Array TemplateParameters;
+  for (const auto &P : S.TemplateParameters) {
+    llvm::json::Object Param{{"name", P.Name},
+                             {"kind", P.Kind},
+                             {"hasDefault", P.HasDefault},
+                             {"isPack", P.IsPack}};
+    if (!P.Type.empty())
+      Param["type"] = P.Type;
+    if (!P.CanonicalType.empty())
+      Param["canonicalType"] = P.CanonicalType;
+    if (P.TypeInfo.Present)
+      Param["typeInfo"] = semanticTypeInfoJSON(P.TypeInfo);
+    TemplateParameters.push_back(std::move(Param));
+  }
+  llvm::json::Object Result{
+      {"qualifiedName", S.QualifiedName},
+      {"kind", S.Kind},
+      {"provenance", llvm::json::Object{{"sema", S.FromSema},
+                                         {"index", S.FromIndex}}},
+      {"isType", S.IsType},
+      {"isValue", S.IsValue},
+      {"isCallable", S.IsCallable},
+      {"isMember", S.IsMember},
+      {"isStatic", S.IsStatic},
+      {"isVariadic", S.IsVariadic},
+      {"parameters", std::move(Parameters)},
+      {"templateParameters", std::move(TemplateParameters)}};
+  if (S.FromSema) {
+    Result["isConstMethod"] = S.IsConstMethod;
+    Result["isVolatileMethod"] = S.IsVolatileMethod;
+    Result["isMutableField"] = S.IsMutableField;
+    if (S.IsBitField)
+      Result["isBitField"] = *S.IsBitField;
+    Result["isAbstract"] = S.IsAbstract;
+    Result["isEmptyAggregate"] = S.IsEmptyAggregate;
+    Result["refQualifier"] = S.RefQualifier;
+  }
+  if (S.IsExplicit)
+    Result["isExplicit"] = *S.IsExplicit;
+  if (!S.ID.empty())
+    Result["id"] = S.ID;
+  if (!S.PrimaryTemplateID.empty())
+    Result["primaryTemplateId"] = S.PrimaryTemplateID;
+  if (!S.Type.empty())
+    Result["type"] = S.Type;
+  if (!S.CanonicalType.empty())
+    Result["canonicalType"] = S.CanonicalType;
+  if (S.TypeInfo.Present)
+    Result["typeInfo"] = semanticTypeInfoJSON(S.TypeInfo);
+  if (!S.ReturnType.empty())
+    Result["returnType"] = S.ReturnType;
+  if (!S.CanonicalReturnType.empty())
+    Result["canonicalReturnType"] = S.CanonicalReturnType;
+  if (S.ReturnTypeInfo.Present)
+    Result["returnTypeInfo"] = semanticTypeInfoJSON(S.ReturnTypeInfo);
+  if (!S.ReturnTemplateOccurrences.empty())
+    Result["returnTemplateOccurrences"] =
+        semanticTemplateOccurrencesJSON(S.ReturnTemplateOccurrences);
+  if (!S.OwnerType.empty())
+    Result["ownerType"] = S.OwnerType;
+  if (!S.CanonicalOwnerType.empty())
+    Result["canonicalOwnerType"] = S.CanonicalOwnerType;
+  if (S.OwnerTypeInfo.Present)
+    Result["ownerTypeInfo"] = semanticTypeInfoJSON(S.OwnerTypeInfo);
+  return Result;
+}
+
+llvm::json::Array semanticCompletionItemsJSON(const CodeCompleteResult &Result) {
+  llvm::json::Array Items;
+  auto Add = [&](const CodeCompletion &C) {
+    if (C.Symbols.empty())
+      return; // Keywords, snippets, macros and raw textual identifiers.
+    if (!C.Includes.empty() &&
+        llvm::all_of(C.Includes, [](const auto &I) { return I.Insertion; }))
+      return; // Index symbol not available without editing an include.
+    llvm::json::Array Symbols;
+    for (const auto &S : C.Symbols)
+      Symbols.push_back(semanticSymbolJSON(S));
+    Items.push_back(llvm::json::Object{
+        {"name", C.Name},
+        {"filterText", C.FilterText},
+        {"scope", C.Scope},
+        {"requiredQualifier", C.RequiredQualifier},
+        {"insertText", C.RequiredQualifier + C.Name},
+        {"signature", C.Signature},
+        {"returnType", C.ReturnType},
+        {"kind", static_cast<int>(C.Kind)},
+        {"score", C.Score.Total},
+        {"symbols", std::move(Symbols)}});
+  };
+  for (const auto &C : Result.Completions)
+    Add(C);
+  for (const auto &C : Result.VisibleDeclarations)
+    Add(C);
+  return Items;
+}
+
+llvm::json::Object semanticGraphJSON(const CodeCompleteResult &Result) {
+  llvm::json::Array Nodes;
+  for (const auto &Node : Result.SemanticGraph) {
+    auto Symbol = semanticSymbolJSON(Node.Symbol);
+    Symbol["name"] = Node.Name;
+    Nodes.push_back(std::move(Symbol));
+  }
+  return llvm::json::Object{{"limit", Result.SemanticGraphLimit},
+                            {"depth", Result.SemanticGraphDepth},
+                            {"isIncomplete", Result.SemanticGraphHasMore},
+                            {"nodes", std::move(Nodes)}};
+}
+
+llvm::json::Object semanticOperationsJSON(const CodeCompleteResult &Result) {
+  llvm::json::Array Nodes;
+  for (const auto &Operation : Result.SemanticOperations) {
+    auto Symbol = semanticSymbolJSON(Operation.Symbol);
+    Symbol["name"] = Operation.Name;
+    Symbol["role"] = Operation.Role;
+    Nodes.push_back(std::move(Symbol));
+  }
+  llvm::json::Array Templates;
+  for (const auto &Template : Result.SemanticCallableTemplates) {
+    llvm::json::Object Schema{
+        {"name", Template.Name},
+        {"role", Template.Role},
+        {"pattern", semanticSymbolJSON(Template.Pattern)},
+        {"minExplicitArguments", Template.MinExplicitArguments},
+        {"requiresCompilerSubstitution",
+         Template.RequiresCompilerSubstitution},
+        {"hasFunctionParameterPack", Template.HasFunctionParameterPack},
+        {"hasCStyleVarargs", Template.HasCStyleVarargs},
+        {"hasAssociatedConstraints", Template.HasAssociatedConstraints},
+        {"hasRequiresClause", Template.HasRequiresClause},
+        {"hasDefinition", Template.HasDefinition},
+        {"hasDependentParameters", Template.HasDependentParameters},
+        {"hasDependentReturnType", Template.HasDependentReturnType},
+        {"hasForwardingReferencePack",
+         Template.HasForwardingReferencePack},
+        {"allParametersAreForwardingReferencePacks",
+         Template.AllParametersAreForwardingReferencePacks}};
+    if (Template.MaxExplicitArguments)
+      Schema["maxExplicitArguments"] = *Template.MaxExplicitArguments;
+    if (!Template.ConstructionTargetType.empty()) {
+      Schema["constructionTargetType"] = Template.ConstructionTargetType;
+      Schema["canonicalConstructionTargetType"] =
+          Template.CanonicalConstructionTargetType;
+      if (Template.ConstructionTargetTypeInfo.Present)
+        Schema["constructionTargetTypeInfo"] =
+            semanticTypeInfoJSON(Template.ConstructionTargetTypeInfo);
+    }
+    Templates.push_back(std::move(Schema));
+  }
+  llvm::json::Array CallWitnesses;
+  for (const auto &Witness : Result.SemanticCallWitnesses) {
+    llvm::json::Array Arguments;
+    for (const auto &Argument : Witness.Arguments)
+      Arguments.push_back(semanticExpressionProfileJSON(Argument));
+    llvm::json::Array ExplicitTemplateArguments;
+    for (const auto &Argument : Witness.ExplicitTemplateArguments)
+      ExplicitTemplateArguments.push_back(
+          semanticTemplateArgumentProfileJSON(Argument));
+    llvm::json::Object Entry{
+        {"name", Witness.Name},
+        {"syntax", Witness.Syntax},
+        {"validation", Witness.Validation},
+        {"authoritative", Witness.Authoritative},
+        {"targetId", Witness.TargetID},
+        {"primaryTemplateId", Witness.PrimaryTemplateID},
+        {"explicitTemplateArguments",
+         std::move(ExplicitTemplateArguments)},
+        {"arguments", std::move(Arguments)},
+        {"callable", semanticSymbolJSON(Witness.Callable)},
+        {"result", semanticExpressionProfileJSON(Witness.Result)}};
+    if (!Witness.OperatorSpelling.empty())
+      Entry["operatorSpelling"] = Witness.OperatorSpelling;
+    if (!Witness.Receiver.Kind.empty())
+      Entry["receiver"] =
+          semanticExpressionProfileJSON(Witness.Receiver);
+    CallWitnesses.push_back(std::move(Entry));
+  }
+  llvm::json::Array ExpressionWitnesses;
+  for (const auto &Witness : Result.SemanticExpressionWitnesses) {
+    llvm::json::Object Entry{
+        {"syntax", Witness.Syntax},
+        {"validation", Witness.Validation},
+        {"authoritative", Witness.Authoritative},
+        {"result", semanticExpressionProfileJSON(Witness.Result)}};
+    if (!Witness.TypeOperand.Type.empty())
+      Entry["typeOperand"] =
+          semanticTypeProfileJSON(Witness.TypeOperand);
+    if (!Witness.ExpressionOperand.Kind.empty())
+      Entry["expressionOperand"] =
+          semanticExpressionProfileJSON(Witness.ExpressionOperand);
+    ExpressionWitnesses.push_back(std::move(Entry));
+  }
+  llvm::json::Array Conversions;
+  for (const auto &Conversion : Result.SemanticConversions) {
+    llvm::json::Object Edge{{"kind", Conversion.Kind},
+                            {"fromType", Conversion.FromType},
+                            {"canonicalFromType",
+                             Conversion.CanonicalFromType},
+                            {"toType", Conversion.ToType},
+                            {"canonicalToType", Conversion.CanonicalToType}};
+    if (Conversion.FromTypeInfo.Present)
+      Edge["fromTypeInfo"] =
+          semanticTypeInfoJSON(Conversion.FromTypeInfo);
+    if (Conversion.ToTypeInfo.Present)
+      Edge["toTypeInfo"] = semanticTypeInfoJSON(Conversion.ToTypeInfo);
+    Conversions.push_back(std::move(Edge));
+  }
+  return llvm::json::Object{
+      {"limit", Result.SemanticOperationLimit},
+      {"depth", Result.SemanticOperationDepth},
+      {"isIncomplete", Result.SemanticOperationsHaveMore ||
+                           Result.SemanticExpressionWitnessesHaveMore ||
+                           Result.SemanticCallWitnessesHaveMore ||
+                           Result.SemanticBinaryOperatorWitnessesHaveMore},
+      {"nodeDiscoveryCount", Result.SemanticOperationNodesDiscovered},
+      {"nodesIncomplete", Result.SemanticOperationNodesHaveMore},
+      {"nodes", std::move(Nodes)},
+      {"templateDiscoveryCount",
+       Result.SemanticCallableTemplatesDiscovered},
+      {"templatesIncomplete", Result.SemanticCallableTemplatesHaveMore},
+      {"templates", std::move(Templates)},
+      {"expressionWitnessLimit", Result.SemanticExpressionWitnessLimit},
+      {"expressionWitnessDiscoveryCount",
+       Result.SemanticExpressionWitnessesDiscovered},
+      {"expressionWitnessProbeCount",
+       Result.SemanticExpressionWitnessProbeCount},
+      {"expressionWitnessesIncomplete",
+       Result.SemanticExpressionWitnessesHaveMore},
+      {"expressionWitnesses", std::move(ExpressionWitnesses)},
+      {"callWitnessLimit", Result.SemanticCallWitnessLimit},
+      {"callWitnessMaxArity", Result.SemanticCallWitnessMaxArity},
+      {"callWitnessDiscoveryCount",
+       Result.SemanticCallWitnessesDiscovered},
+      {"callWitnessProbeCount", Result.SemanticCallWitnessProbeCount},
+      {"binaryOperatorWitnessDiscoveryCount",
+       Result.SemanticBinaryOperatorWitnessesDiscovered},
+      {"binaryOperatorWitnessProbeCount",
+       Result.SemanticBinaryOperatorWitnessProbeCount},
+      {"binaryOperatorWitnessesIncomplete",
+       Result.SemanticBinaryOperatorWitnessesHaveMore},
+      {"callWitnessesIncomplete",
+       Result.SemanticCallWitnessesHaveMore},
+      {"callWitnesses", std::move(CallWitnesses)},
+      {"conversionDiscoveryCount", Result.SemanticConversionsDiscovered},
+      {"conversionsIncomplete", Result.SemanticConversionsHaveMore},
+      {"conversions", std::move(Conversions)}};
+}
+
+llvm::json::Value
+semanticCompletionJSON(const CodeCompleteResult &Result,
+                       const CodeCompleteResult *ScopeResult = nullptr) {
+  llvm::json::Object Context{
+      {"kind", getCompletionKindString(Result.Context)},
+      {"queryScopes", llvm::json::Array(Result.QueryScopes)},
+      {"accessibleScopes", llvm::json::Array(Result.AccessibleScopes)}};
+  if (!Result.PreferredType.empty())
+    Context["preferredType"] = Result.PreferredType;
+  if (!Result.CanonicalPreferredType.empty())
+    Context["canonicalPreferredType"] = Result.CanonicalPreferredType;
+  if (Result.PreferredTypeInfo.Present)
+    Context["preferredTypeInfo"] =
+        semanticTypeInfoJSON(Result.PreferredTypeInfo);
+  if (!Result.BaseType.empty())
+    Context["baseType"] = Result.BaseType;
+  if (!Result.CanonicalBaseType.empty())
+    Context["canonicalBaseType"] = Result.CanonicalBaseType;
+  if (Result.BaseTypeInfo.Present)
+    Context["baseTypeInfo"] = semanticTypeInfoJSON(Result.BaseTypeInfo);
+  if (!Result.EnclosingReturnType.empty())
+    Context["enclosingReturnType"] = Result.EnclosingReturnType;
+  if (!Result.CanonicalEnclosingReturnType.empty())
+    Context["canonicalEnclosingReturnType"] =
+        Result.CanonicalEnclosingReturnType;
+  if (Result.EnclosingReturnTypeInfo.Present)
+    Context["enclosingReturnTypeInfo"] =
+        semanticTypeInfoJSON(Result.EnclosingReturnTypeInfo);
+  if (!Result.EnclosingClassType.empty())
+    Context["enclosingClassType"] = Result.EnclosingClassType;
+  if (!Result.CanonicalEnclosingClassType.empty())
+    Context["canonicalEnclosingClassType"] =
+        Result.CanonicalEnclosingClassType;
+  if (Result.EnclosingClassTypeInfo.Present)
+    Context["enclosingClassTypeInfo"] =
+        semanticTypeInfoJSON(Result.EnclosingClassTypeInfo);
+  if (!Result.ThisType.empty())
+    Context["thisType"] = Result.ThisType;
+  if (!Result.CanonicalThisType.empty())
+    Context["canonicalThisType"] = Result.CanonicalThisType;
+  if (Result.ThisTypeInfo.Present)
+    Context["thisTypeInfo"] = semanticTypeInfoJSON(Result.ThisTypeInfo);
+
+  const bool HasGraph = ScopeResult &&
+                        (ScopeResult->SemanticGraphLimit != 0 ||
+                         ScopeResult->SemanticOperationLimit != 0 ||
+                         ScopeResult->SemanticExpressionWitnessLimit != 0);
+  llvm::json::Object Out{{"schemaVersion", HasGraph ? 2 : 1},
+                         {"isIncomplete", Result.HasMore},
+                         {"ranParser", Result.RanParser},
+                         {"context", std::move(Context)},
+                         {"items", semanticCompletionItemsJSON(Result)}};
+  if (!Result.ActiveCallables.empty()) {
+    llvm::json::Array ActiveCallables;
+    for (const auto &S : Result.ActiveCallables)
+      ActiveCallables.push_back(semanticSymbolJSON(S));
+    Out["activeCallables"] = std::move(ActiveCallables);
+    if (Result.ActiveArgument)
+      Out["activeArgument"] = *Result.ActiveArgument;
+    Out["activeCallIsBraced"] = Result.ActiveCallIsBraced;
+  }
+  if (Result.CompletionRange)
+    Out["completionRange"] = toJSON(*Result.CompletionRange);
+  if (ScopeResult) {
+    Out["scopeItems"] = semanticCompletionItemsJSON(*ScopeResult);
+    Out["scopeIsIncomplete"] =
+        ScopeResult->HasMore || ScopeResult->SemanticGraphHasMore ||
+        ScopeResult->SemanticOperationsHaveMore ||
+        ScopeResult->SemanticExpressionWitnessesHaveMore ||
+        ScopeResult->SemanticCallWitnessesHaveMore ||
+        ScopeResult->SemanticBinaryOperatorWitnessesHaveMore;
+    if (HasGraph)
+      Out["graph"] = semanticGraphJSON(*ScopeResult);
+    if (ScopeResult->SemanticOperationLimit ||
+        ScopeResult->SemanticExpressionWitnessLimit)
+      Out["operations"] = semanticOperationsJSON(*ScopeResult);
+  }
+  return Out;
+}
