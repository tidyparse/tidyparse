+llvm::json::Array semanticTemplateOccurrencesJSON(
+    llvm::ArrayRef<SemanticCompletionTemplateOccurrence> Occurrences) {
+  llvm::json::Array Result;
+  for (const auto &Occurrence : Occurrences)
+    Result.push_back(llvm::json::Object{{"name", Occurrence.Name},
+                                        {"kind", Occurrence.Kind},
+                                        {"depth", Occurrence.Depth},
+                                        {"index", Occurrence.Index},
+                                        {"isPack", Occurrence.IsPack}});
+  return Result;
+}
