+      Reference->getPointeeType()->getAs<TemplateTypeParmType>();
+  const auto *Parameter = TypeParameter ? TypeParameter->getDecl() : nullptr;
+  if (Parameter &&
+      llvm::is_contained(*Template.getTemplateParameters(), Parameter))
+    return true;
+  // Instantiating a member template of a class-template specialization can
+  // clone the TemplateTypeParmDecl. Depth/index is Clang's semantic identity
+  // for template parameters and remains stable across that cloning.
+  if (!TypeParameter)
+    return false;
+  return llvm::any_of(*Template.getTemplateParameters(),
+                      [&](const NamedDecl *Candidate) {
+                        const auto *TemplateType =
+                            dyn_cast<TemplateTypeParmDecl>(Candidate);
+                        return TemplateType &&
+                               TemplateType->getDepth() ==
+                                   TypeParameter->getDepth() &&
+                               TemplateType->getIndex() ==
+                                   TypeParameter->getIndex();
+                      });
