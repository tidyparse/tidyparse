+/// information directly, bypassing preprocessing. The generated grammar emits
+/// source tokens, so any active macro identifier in that spelling would be
+/// expanded before the compiler sees the proven declaration/type.
+bool containsActiveMacroIdentifier(llvm::StringRef Spelling,
+                                   Preprocessor &PP) {
+  SourceLocation CompletionLoc = PP.getCodeCompletionLoc();
+  // Macro history is location-sensitive (#undef and later redefinition both
+  // matter). Without the exact completion file location no source spelling is
+  // authenticated, so fail closed.
+  if (CompletionLoc.isInvalid() || !CompletionLoc.isFileID())
+    return true;
