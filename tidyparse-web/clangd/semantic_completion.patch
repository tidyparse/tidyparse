+struct SemaCompleteInput {
+  PathRef FileName;
+  size_t Offset;
+  const PreambleData &Preamble;
+  const std::optional<PreamblePatch> Patch;
+  const ParseInputs &ParseInput;
+};
+
+void loadMainFilePreambleMacros(const Preprocessor &PP,
+                                const PreambleData &Preamble) {
+  // The ExternalPreprocessorSource has our macros, if we know where to look.
+  // We can read all the macros using PreambleMacros->ReadDefinedMacros(),
+  // but this includes transitively included files, so may deserialize a lot.
+  ExternalPreprocessorSource *PreambleMacros = PP.getExternalSource();
+  // As we have the names of the macros, we can look up their IdentifierInfo
+  // and then use this to load just the macros we want.
+  const auto &ITable = PP.getIdentifierTable();
+  IdentifierInfoLookup *PreambleIdentifiers =
+      ITable.getExternalIdentifierLookup();
+
+  if (!PreambleIdentifiers || !PreambleMacros)
+    return;
+  for (const auto &MacroName : Preamble.Macros.Names) {
+    if (ITable.find(MacroName.getKey()) != ITable.end())
+      continue;
+    if (auto *II = PreambleIdentifiers->get(MacroName.getKey()))
+      if (II->isOutOfDate())
+        PreambleMacros->updateOutOfDateIdentifier(*II);
+  }
+}
+
+class SemanticCompletionAction final : public SyntaxOnlyAction {
+protected:
+  std::unique_ptr<ASTConsumer>
+  CreateASTConsumer(CompilerInstance &, llvm::StringRef) override {
+    class RetainFunctionBodiesConsumer final : public ASTConsumer {
+      bool shouldSkipFunctionBody(Decl *) override { return false; }
+    };
+    return std::make_unique<RetainFunctionBodiesConsumer>();
+  }
+};
+
+// Invokes Sema code completion on a file.
+// If \p Includes is set, it will be updated based on the compiler invocation.
+bool semaCodeComplete(std::unique_ptr<CodeCompleteConsumer> Consumer,
+                      const clang::CodeCompleteOptions &Options,
+                      const SemaCompleteInput &Input,
+                      IncludeStructure *Includes = nullptr) {
+  trace::Span Tracer("Sema completion");
+
+  IgnoreDiagnostics IgnoreDiags;
+  auto CI = buildCompilerInvocation(Input.ParseInput, IgnoreDiags);
+  if (!CI) {
+    elog("Couldn't create CompilerInvocation");
+    return false;
+  }
+  auto &FrontendOpts = CI->getFrontendOpts();
+  // Authoritative semantic call witnesses instantiate selected definitions.
+  // Retain bodies in the completion AST so validation observes the same
+  // substitution and definition errors as an ordinary compilation.
+  FrontendOpts.SkipFunctionBodies = false;
+  // Disable typo correction in Sema.
+  CI->getLangOpts().SpellChecking = false;
+  // Code completion won't trigger in delayed template bodies.
+  // This is on-by-default in windows to allow parsing SDK headers; we're only
+  // disabling it for the main-file (not preamble).
+  CI->getLangOpts().DelayedTemplateParsing = false;
+  // Setup code completion.
+  FrontendOpts.CodeCompleteOpts = Options;
+  FrontendOpts.CodeCompletionAt.FileName = std::string(Input.FileName);
+  std::tie(FrontendOpts.CodeCompletionAt.Line,
+           FrontendOpts.CodeCompletionAt.Column) =
+      offsetToClangLineColumn(Input.ParseInput.Contents, Input.Offset);
+
+  std::unique_ptr<llvm::MemoryBuffer> ContentsBuffer =
+      llvm::MemoryBuffer::getMemBuffer(Input.ParseInput.Contents,
+                                       Input.FileName);
+  // The diagnostic options must be set before creating a CompilerInstance.
+  CI->getDiagnosticOpts().IgnoreWarnings = true;
+  // We reuse the preamble whether it's valid or not. This is a
+  // correctness/performance tradeoff: building without a preamble is slow, and
+  // completion is latency-sensitive.
+  // However, if we're completing *inside* the preamble section of the draft,
+  // overriding the preamble will break sema completion. Fortunately we can just
+  // skip all includes in this case; these completions are really simple.
+  PreambleBounds PreambleRegion =
+      ComputePreambleBounds(CI->getLangOpts(), *ContentsBuffer, 0);
+  bool CompletingInPreamble = Input.Offset < PreambleRegion.Size ||
+                              (!PreambleRegion.PreambleEndsAtStartOfLine &&
+                               Input.Offset == PreambleRegion.Size);
+  if (Input.Patch)
+    Input.Patch->apply(*CI);
+  // NOTE: we must call BeginSourceFile after prepareCompilerInstance. Otherwise
+  // the remapped buffers do not get freed.
+  llvm::IntrusiveRefCntPtr<llvm::vfs::FileSystem> VFS =
+      Input.ParseInput.TFS->view(Input.ParseInput.CompileCommand.Directory);
+  if (Input.Preamble.StatCache)
+    VFS = Input.Preamble.StatCache->getConsumingFS(std::move(VFS));
+  auto Clang = prepareCompilerInstance(
+      std::move(CI), !CompletingInPreamble ? &Input.Preamble.Preamble : nullptr,
+      std::move(ContentsBuffer), std::move(VFS), IgnoreDiags);
+  Clang->getPreprocessorOpts().SingleFileParseMode = CompletingInPreamble;
+  Clang->setCodeCompletionConsumer(Consumer.release());
+
+  if (Input.Preamble.RequiredModules)
+    Input.Preamble.RequiredModules->adjustHeaderSearchOptions(Clang->getHeaderSearchOpts());
+
+  SemanticCompletionAction Action;
+  if (!Action.BeginSourceFile(*Clang, Clang->getFrontendOpts().Inputs[0])) {
+    log("BeginSourceFile() failed when running codeComplete for {0}",
+        Input.FileName);
+    return false;
+  }
+  // Macros can be defined within the preamble region of the main file.
+  // They don't fall nicely into our index/Sema dichotomy:
+  //  - they're not indexed for completion (they're not available across files)
+  //  - but Sema code complete won't see them: as part of the preamble, they're
+  //    deserialized only when mentioned.
+  // Force them to be deserialized so SemaCodeComplete sees them.
+  loadMainFilePreambleMacros(Clang->getPreprocessor(), Input.Preamble);
+  if (Includes)
+    Includes->collect(*Clang);
+  if (llvm::Error Err = Action.Execute()) {
+    log("Execute() failed when running codeComplete for {0}: {1}",
+        Input.FileName, toString(std::move(Err)));
+    return false;
+  }
+  Action.EndSourceFile();
+
+  return true;
+}
+
+// Should we allow index completions in the specified context?
+bool allowIndex(CodeCompletionContext &CC) {
+  if (!contextAllowsIndex(CC.getKind()))
+    return false;
+  // We also avoid ClassName::bar (but allow namespace::bar).
+  auto Scope = CC.getCXXScopeSpecifier();
+  if (!Scope)
+    return true;
+  NestedNameSpecifier *NameSpec = (*Scope)->getScopeRep();
+  if (!NameSpec)
+    return true;
+  // We only query the index when qualifier is a namespace.
+  // If it's a class, we rely solely on sema completions.
+  switch (NameSpec->getKind()) {
+  case NestedNameSpecifier::Global:
+  case NestedNameSpecifier::Namespace:
+  case NestedNameSpecifier::NamespaceAlias:
+    return true;
+  case NestedNameSpecifier::Super:
+  case NestedNameSpecifier::TypeSpec:
+  // Unresolved inside a template.
+  case NestedNameSpecifier::Identifier:
+    return false;
+  }
+  llvm_unreachable("invalid NestedNameSpecifier kind");
+}
+
+// Should we include a symbol from the index given the completion kind?
+// FIXME: Ideally we can filter in the fuzzy find request itself.
+bool includeSymbolFromIndex(CodeCompletionContext::Kind Kind,
+                            const Symbol &Sym) {
+  // Objective-C protocols are only useful in ObjC protocol completions,
+  // in other places they're confusing, especially when they share the same
+  // identifier with a class.
+  if (Sym.SymInfo.Kind == index::SymbolKind::Protocol &&
+      Sym.SymInfo.Lang == index::SymbolLanguage::ObjC)
+    return Kind == CodeCompletionContext::CCC_ObjCProtocolName;
+  else if (Kind == CodeCompletionContext::CCC_ObjCProtocolName)
+    // Don't show anything else in ObjC protocol completions.
+    return false;
+
+  if (Kind == CodeCompletionContext::CCC_ObjCClassForwardDecl)
+    return Sym.SymInfo.Kind == index::SymbolKind::Class &&
+           Sym.SymInfo.Lang == index::SymbolLanguage::ObjC;
+  return true;
+}
+
+std::future<std::pair<bool, SymbolSlab>>
+startAsyncFuzzyFind(const SymbolIndex &Index, const FuzzyFindRequest &Req) {
+  return runAsync<std::pair<bool, SymbolSlab>>([&Index, Req]() {
+    trace::Span Tracer("Async fuzzyFind");
+    SymbolSlab::Builder Syms;
+    bool Incomplete =
+        Index.fuzzyFind(Req, [&Syms](const Symbol &Sym) { Syms.insert(Sym); });
+    return std::make_pair(Incomplete, std::move(Syms).build());
+  });
+}
+
+// Creates a `FuzzyFindRequest` based on the cached index request from the
+// last completion, if any, and the speculated completion filter text in the
+// source code.
+FuzzyFindRequest speculativeFuzzyFindRequestForCompletion(
+    FuzzyFindRequest CachedReq, const CompletionPrefix &HeuristicPrefix) {
+  CachedReq.Query = std::string(HeuristicPrefix.Name);
+  return CachedReq;
+}
+
+// This function is similar to Lexer::findNextToken(), but assumes
+// that the input SourceLocation is the completion point (which is
+// a case findNextToken() does not handle).
+std::optional<Token>
+findTokenAfterCompletionPoint(SourceLocation CompletionPoint,
+                              const SourceManager &SM,
+                              const LangOptions &LangOpts) {
+  SourceLocation Loc = CompletionPoint;
+  if (Loc.isMacroID()) {
+    if (!Lexer::isAtEndOfMacroExpansion(Loc, SM, LangOpts, &Loc))
+      return std::nullopt;
+  }
+
+  // Advance to the next SourceLocation after the completion point.
+  // Lexer::findNextToken() would call MeasureTokenLength() here,
+  // which does not handle the completion point (and can't, because
   // the Lexer instance it constructs internally doesn't have a
   // Preprocessor and so doesn't know about the completion point).
   Loc = Loc.getLocWithOffset(1);
 
-  // Break down the source location.
-  std::pair<FileID, unsigned> LocInfo = SM.getDecomposedLoc(Loc);
+  // Break down the source location.
+  std::pair<FileID, unsigned> LocInfo = SM.getDecomposedLoc(Loc);
+
+  // Try to load the file buffer.
+  bool InvalidTemp = false;
+  StringRef File = SM.getBufferData(LocInfo.first, &InvalidTemp);
+  if (InvalidTemp)
+    return std::nullopt;
+
+  const char *TokenBegin = File.data() + LocInfo.second;
+
+  // Lex from the start of the given location.
+  Lexer TheLexer(SM.getLocForStartOfFile(LocInfo.first), LangOpts, File.begin(),
+                 TokenBegin, File.end());
+  // Find the token.
+  Token Tok;
+  TheLexer.LexFromRawLexer(Tok);
+  return Tok;
+}
+
+// Runs Sema-based (AST) and Index-based completion, returns merged results.
+//
+// There are a few tricky considerations:
+//   - the AST provides information needed for the index query (e.g. which
+//     namespaces to search in). So Sema must start first.
+//   - we only want to return the top results (Opts.Limit).
+//     Building CompletionItems for everything else is wasteful, so we want to
+//     preserve the "native" format until we're done with scoring.
+//   - the data underlying Sema completion items is owned by the AST and various
+//     other arenas, which must stay alive for us to build CompletionItems.
+//   - we may get duplicate results from Sema and the Index, we need to merge.
+//
+// So we start Sema completion first, and do all our work in its callback.
+// We use the Sema context information to query the index.
+// Then we merge the two result sets, producing items that are Sema/Index/Both.
+// These items are scored, and the top N are synthesized into the LSP response.
+// Finally, we can clean up the data structures created by Sema completion.
+//
+// Main collaborators are:
+//   - semaCodeComplete sets up the compiler machinery to run code completion.
+//   - CompletionRecorder captures Sema completion results, including context.
+//   - SymbolIndex (Opts.Index) provides index completion results as Symbols
+//   - CompletionCandidates are the result of merging Sema and Index results.
+//     Each candidate points to an underlying CodeCompletionResult (Sema), a
+//     Symbol (Index), or both. It computes the result quality score.
+//     CompletionCandidate also does conversion to CompletionItem (at the end).
+//   - FuzzyMatcher scores how the candidate matches the partial identifier.
+//     This score is combined with the result quality score for the final score.
+//   - TopN determines the results with the best score.
+class CodeCompleteFlow {
+  PathRef FileName;
+  IncludeStructure Includes;           // Complete once the compiler runs.
+  SpeculativeFuzzyFind *SpecFuzzyFind; // Can be nullptr.
+  const CodeCompleteOptions &Opts;
+
+  // Sema takes ownership of Recorder. Recorder is valid until Sema cleanup.
+  CompletionRecorder *Recorder = nullptr;
+  CodeCompletionContext::Kind CCContextKind = CodeCompletionContext::CCC_Other;
+  bool IsUsingDeclaration = false;
+  // The snippets will not be generated if the token following completion
+  // location is an opening parenthesis (tok::l_paren) because this would add
+  // extra parenthesis.
+  tok::TokenKind NextTokenKind = tok::eof;
+  // Counters for logging.
+  int NSema = 0, NIndex = 0, NSemaAndIndex = 0, NIdent = 0;
+  bool Incomplete = false; // Would more be available with a higher limit?
+  CompletionPrefix HeuristicPrefix;
+  std::optional<FuzzyMatcher> Filter; // Initialized once Sema runs.
+  Range ReplacedRange;
+  std::vector<std::string> QueryScopes;      // Initialized once Sema runs.
+  std::vector<std::string> AccessibleScopes; // Initialized once Sema runs.
+  // Initialized once QueryScopes is initialized, if there are scopes.
+  std::optional<ScopeDistance> ScopeProximity;
+  std::optional<OpaqueType> PreferredType; // Initialized once Sema runs.
+  // Whether to query symbols from any scope. Initialized once Sema runs.
+  bool AllScopes = false;
+  llvm::StringSet<> ContextWords;
+  // Include-insertion and proximity scoring rely on the include structure.
+  // This is available after Sema has run.
+  std::optional<IncludeInserter> Inserter;  // Available during runWithSema.
+  std::optional<URIDistance> FileProximity; // Initialized once Sema runs.
+  /// Speculative request based on the cached request and the filter text before
+  /// the cursor.
+  /// Initialized right before sema run. This is only set if `SpecFuzzyFind` is
+  /// set and contains a cached request.
+  std::optional<FuzzyFindRequest> SpecReq;
+
+public:
+  // A CodeCompleteFlow object is only useful for calling run() exactly once.
+  CodeCompleteFlow(PathRef FileName, const IncludeStructure &Includes,
+                   SpeculativeFuzzyFind *SpecFuzzyFind,
+                   const CodeCompleteOptions &Opts)
+      : FileName(FileName), Includes(Includes), SpecFuzzyFind(SpecFuzzyFind),
+        Opts(Opts) {}
+
+  CodeCompleteResult run(const SemaCompleteInput &SemaCCInput) && {
+    trace::Span Tracer("CodeCompleteFlow");
+    HeuristicPrefix = guessCompletionPrefix(SemaCCInput.ParseInput.Contents,
+                                            SemaCCInput.Offset);
+    populateContextWords(SemaCCInput.ParseInput.Contents);
+    if (Opts.Index && SpecFuzzyFind && SpecFuzzyFind->CachedReq) {
+      assert(!SpecFuzzyFind->Result.valid());
+      SpecReq = speculativeFuzzyFindRequestForCompletion(
+          *SpecFuzzyFind->CachedReq, HeuristicPrefix);
+      SpecFuzzyFind->Result = startAsyncFuzzyFind(*Opts.Index, *SpecReq);
+    }
+
+    // We run Sema code completion first. It builds an AST and calculates:
+    //   - completion results based on the AST.
+    //   - partial identifier and context. We need these for the index query.
+    CodeCompleteResult Output;
+    auto RecorderOwner = std::make_unique<CompletionRecorder>(Opts, [&]() {
+      assert(Recorder && "Recorder is not set");
+      CCContextKind = Recorder->CCContext.getKind();
+      IsUsingDeclaration = Recorder->CCContext.isUsingDeclaration();
+      auto Style = getFormatStyleForFile(SemaCCInput.FileName,
+                                         SemaCCInput.ParseInput.Contents,
+                                         *SemaCCInput.ParseInput.TFS, false);
+      const auto NextToken = findTokenAfterCompletionPoint(
+          Recorder->CCSema->getPreprocessor().getCodeCompletionLoc(),
+          Recorder->CCSema->getSourceManager(), Recorder->CCSema->LangOpts);
+      if (NextToken)
+        NextTokenKind = NextToken->getKind();
+      // If preprocessor was run, inclusions from preprocessor callback should
+      // already be added to Includes.
+      Inserter.emplace(
+          SemaCCInput.FileName, SemaCCInput.ParseInput.Contents, Style,
+          SemaCCInput.ParseInput.CompileCommand.Directory,
+          &Recorder->CCSema->getPreprocessor().getHeaderSearchInfo(),
+          Config::current().Style.QuotedHeaders,
+          Config::current().Style.AngledHeaders);
+      for (const auto &Inc : Includes.MainFileIncludes)
+        Inserter->addExisting(Inc);
+
+      // Most of the cost of file proximity is in initializing the FileDistance
+      // structures based on the observed includes, once per query. Conceptually
+      // that happens here (though the per-URI-scheme initialization is lazy).
+      // The per-result proximity scoring is (amortized) very cheap.
+      FileDistanceOptions ProxOpts{}; // Use defaults.
+      const auto &SM = Recorder->CCSema->getSourceManager();
+      llvm::StringMap<SourceParams> ProxSources;
+      auto MainFileID =
+          Includes.getID(SM.getFileEntryForID(SM.getMainFileID()));
+      assert(MainFileID);
+      for (auto &HeaderIDAndDepth : Includes.includeDepth(*MainFileID)) {
+        auto &Source =
+            ProxSources[Includes.getRealPath(HeaderIDAndDepth.getFirst())];
+        Source.Cost = HeaderIDAndDepth.getSecond() * ProxOpts.IncludeCost;
+        // Symbols near our transitive includes are good, but only consider
+        // things in the same directory or below it. Otherwise there can be
+        // many false positives.
+        if (HeaderIDAndDepth.getSecond() > 0)
+          Source.MaxUpTraversals = 1;
+      }
+      FileProximity.emplace(ProxSources, ProxOpts);
+
+      Output = runWithSema();
+      Inserter.reset(); // Make sure this doesn't out-live Clang.
+      SPAN_ATTACH(Tracer, "sema_completion_kind",
+                  getCompletionKindString(CCContextKind));
+      log("Code complete: sema context {0}, query scopes [{1}] (AnyScope={2}), "
+          "expected type {3}{4}",
+          getCompletionKindString(CCContextKind),
+          llvm::join(QueryScopes.begin(), QueryScopes.end(), ","), AllScopes,
+          PreferredType ? Recorder->CCContext.getPreferredType().getAsString()
+                        : "<none>",
+          IsUsingDeclaration ? ", inside using declaration" : "");
+    }, [&]() {
+      // Usually overloads arrive before completion results. Keep this update
+      // independent so parser recovery paths that report them later are exact
+      // too.
+      Output.ActiveCallables = Recorder->ActiveCallables;
+      Output.ActiveArgument = Recorder->ActiveArgument;
+      Output.ActiveCallIsBraced = Recorder->ActiveCallIsBraced;
+    });
+
+    Recorder = RecorderOwner.get();
+
+    semaCodeComplete(std::move(RecorderOwner), Opts.getClangCompleteOpts(),
+                     SemaCCInput, &Includes);
+    logResults(Output, Tracer);
+    return Output;
+  }
+
+  void logResults(const CodeCompleteResult &Output, const trace::Span &Tracer) {
+    SPAN_ATTACH(Tracer, "sema_results", NSema);
+    SPAN_ATTACH(Tracer, "index_results", NIndex);
+    SPAN_ATTACH(Tracer, "merged_results", NSemaAndIndex);
+    SPAN_ATTACH(Tracer, "identifier_results", NIdent);
+    SPAN_ATTACH(Tracer, "returned_results", int64_t(Output.Completions.size()));
+    SPAN_ATTACH(Tracer, "incomplete", Output.HasMore);
+    log("Code complete: {0} results from Sema, {1} from Index, "
+        "{2} matched, {3} from identifiers, {4} returned{5}.",
+        NSema, NIndex, NSemaAndIndex, NIdent, Output.Completions.size(),
+        Output.HasMore ? " (incomplete)" : "");
+    assert(!Opts.Limit || Output.Completions.size() <= Opts.Limit);
+    // We don't assert that isIncomplete means we hit a limit.
+    // Indexes may choose to impose their own limits even if we don't have one.
+  }
+
+  CodeCompleteResult runWithoutSema(llvm::StringRef Content, size_t Offset,
+                                    const ThreadsafeFS &TFS) && {
+    trace::Span Tracer("CodeCompleteWithoutSema");
+    // Fill in fields normally set by runWithSema()
+    HeuristicPrefix = guessCompletionPrefix(Content, Offset);
+    populateContextWords(Content);
+    CCContextKind = CodeCompletionContext::CCC_Recovery;
+    IsUsingDeclaration = false;
+    Filter = FuzzyMatcher(HeuristicPrefix.Name);
+    auto Pos = offsetToPosition(Content, Offset);
+    ReplacedRange.start = ReplacedRange.end = Pos;
+    ReplacedRange.start.character -= HeuristicPrefix.Name.size();
+
+    llvm::StringMap<SourceParams> ProxSources;
+    ProxSources[FileName].Cost = 0;
+    FileProximity.emplace(ProxSources);
+
+    auto Style = getFormatStyleForFile(FileName, Content, TFS, false);
+    // This will only insert verbatim headers.
+    Inserter.emplace(FileName, Content, Style,
+                     /*BuildDir=*/"", /*HeaderSearchInfo=*/nullptr,
+                     Config::current().Style.QuotedHeaders,
+                     Config::current().Style.AngledHeaders);
+
+    auto Identifiers = collectIdentifiers(Content, Style);
+    std::vector<RawIdentifier> IdentifierResults;
+    for (const auto &IDAndCount : Identifiers) {
+      RawIdentifier ID;
+      ID.Name = IDAndCount.first();
+      ID.References = IDAndCount.second;
+      // Avoid treating typed filter as an identifier.
+      if (ID.Name == HeuristicPrefix.Name)
+        --ID.References;
+      if (ID.References > 0)
+        IdentifierResults.push_back(std::move(ID));
+    }
+
+    // Simplified version of getQueryScopes():
+    //  - accessible scopes are determined heuristically.
+    //  - all-scopes query if no qualifier was typed (and it's allowed).
+    SpecifiedScope Scopes;
+    Scopes.QueryScopes = visibleNamespaces(
+        Content.take_front(Offset), format::getFormattingLangOpts(Style));
+    for (std::string &S : Scopes.QueryScopes)
+      if (!S.empty())
+        S.append("::"); // visibleNamespaces doesn't include trailing ::.
+    if (HeuristicPrefix.Qualifier.empty())
+      AllScopes = Opts.AllScopes;
+    else if (HeuristicPrefix.Qualifier.starts_with("::")) {
+      Scopes.QueryScopes = {""};
+      Scopes.UnresolvedQualifier =
+          std::string(HeuristicPrefix.Qualifier.drop_front(2));
+    } else
+      Scopes.UnresolvedQualifier = std::string(HeuristicPrefix.Qualifier);
+    // First scope is the (modified) enclosing scope.
+    QueryScopes = Scopes.scopesForIndexQuery();
+    AccessibleScopes = QueryScopes;
+    ScopeProximity.emplace(QueryScopes);
+
+    SymbolSlab IndexResults = Opts.Index ? queryIndex() : SymbolSlab();
+
+    CodeCompleteResult Output = toCodeCompleteResult(mergeResults(
+        /*SemaResults=*/{}, IndexResults, IdentifierResults));
+    Output.RanParser = false;
+    logResults(Output, Tracer);
+    return Output;
+  }
+
+private:
+  void populateContextWords(llvm::StringRef Content) {
+    // Take last 3 lines before the completion point.
+    unsigned RangeEnd = HeuristicPrefix.Qualifier.begin() - Content.data(),
+             RangeBegin = RangeEnd;
+    for (size_t I = 0; I < 3 && RangeBegin > 0; ++I) {
+      auto PrevNL = Content.rfind('\n', RangeBegin);
+      if (PrevNL == StringRef::npos) {
+        RangeBegin = 0;
+        break;
+      }
+      RangeBegin = PrevNL;
+    }
+
+    ContextWords = collectWords(Content.slice(RangeBegin, RangeEnd));
+    dlog("Completion context words: {0}",
+         llvm::join(ContextWords.keys(), ", "));
+  }
+
+  // This is called by run() once Sema code completion is done, but before the
+  // Sema data structures are torn down. It does all the real work.
+  CodeCompleteResult runWithSema() {
+    const auto &CodeCompletionRange = CharSourceRange::getCharRange(
+        Recorder->CCSema->getPreprocessor().getCodeCompletionTokenRange());
+    // When we are getting completions with an empty identifier, for example
+    //    std::vector<int> asdf;
+    //    asdf.^;
+    // Then the range will be invalid and we will be doing insertion, use
+    // current cursor position in such cases as range.
+    if (CodeCompletionRange.isValid()) {
+      ReplacedRange = halfOpenToRange(Recorder->CCSema->getSourceManager(),
+                                      CodeCompletionRange);
+    } else {
+      const auto &Pos = sourceLocToPosition(
+          Recorder->CCSema->getSourceManager(),
+          Recorder->CCSema->getPreprocessor().getCodeCompletionLoc());
+      ReplacedRange.start = ReplacedRange.end = Pos;
+    }
+    Filter = FuzzyMatcher(
+        Recorder->CCSema->getPreprocessor().getCodeCompletionFilter());
+    auto SpecifiedScopes = getQueryScopes(
+        Recorder->CCContext, *Recorder->CCSema, HeuristicPrefix, Opts);
+
+    QueryScopes = SpecifiedScopes.scopesForIndexQuery();
+    AccessibleScopes = SpecifiedScopes.scopesForQualification();
+    AllScopes = SpecifiedScopes.AllowAllScopes;
+    if (!QueryScopes.empty())
+      ScopeProximity.emplace(QueryScopes);
+    PreferredType =
+        OpaqueType::fromType(Recorder->CCSema->getASTContext(),
+                             Recorder->CCContext.getPreferredType());
+    // Sema provides the needed context to query the index.
+    // FIXME: in addition to querying for extra/overlapping symbols, we should
+    //        explicitly request symbols corresponding to Sema results.
+    //        We can use their signals even if the index can't suggest them.
+    // We must copy index results to preserve them, but there are at most Limit.
+    auto IndexResults = (Opts.Index && allowIndex(Recorder->CCContext))
+                            ? queryIndex()
+                            : SymbolSlab();
+    trace::Span Tracer("Populate CodeCompleteResult");
+    // Merge Sema and Index results, score them, and pick the winners.
+    auto Top =
+        mergeResults(Recorder->Results, IndexResults, /*Identifiers*/ {});
+    auto Output = toCodeCompleteResult(Top);
+    Output.ActiveCallables = Recorder->ActiveCallables;
+    Output.ActiveArgument = Recorder->ActiveArgument;
+    Output.ActiveCallIsBraced = Recorder->ActiveCallIsBraced;
+    llvm::StringRef TypedPrefix =
+        Recorder->CCSema->getPreprocessor().getCodeCompletionFilter();
+    if (Opts.IncludeSemanticDetails && !TypedPrefix.empty()) {
+      // A partial namespace token ("pro" in place of "project::") normally
+      // completes only the namespace declaration. Re-enter Clang's ordinary
+      // qualified-id completion while the parser/Sema state is still alive,
+      // then rank those exact results with an empty child-name filter.
+      const size_t ExpansionLimit =
+          Opts.Limit ? std::max<size_t>(1, Opts.Limit / 2) : 64;
+      std::vector<CodeCompletion> Expanded;
+      using NamespaceExpansion =
+          std::tuple<NamedDecl *, std::string, unsigned>;
+      llvm::SmallVector<NamespaceExpansion, 4> Pending;
+      bool ExpansionTruncated = false;
+      unsigned Root = 0;
+      for (size_t I = 0; I < Top.size(); ++I) {
+        for (const auto &Candidate : Top[I].first) {
+          if (!Candidate.SemaResult ||
+              Candidate.SemaResult->Kind !=
+                  CodeCompletionResult::RK_Declaration)
+            continue;
+          NamedDecl *Namespace = namespaceDeclaration(
+              Candidate.SemaResult->getDeclaration());
+          if (!Namespace || !Recorder->getName(*Candidate.SemaResult)
+                                 .starts_with(TypedPrefix))
+            continue;
+          if (Pending.size() == ExpansionLimit) {
+            ExpansionTruncated = true;
+            continue;
+          }
+          Pending.emplace_back(
+              Namespace, Output.Completions[I].RequiredQualifier +
+                             Output.Completions[I].Name + "::",
+              Root++);
+        }
+      }
+
+      auto PrimaryContext = Recorder->CCContext;
+      auto PrimaryKind = CCContextKind;
+      auto PrimaryFilter = std::move(Filter);
+      llvm::SmallVector<std::pair<unsigned, const NamespaceDecl *>, 8>
+          VisitedNamespaces;
+      Sema &S = *Recorder->CCSema;
+      size_t P = 0;
+      for (; P < Pending.size() && Expanded.size() < ExpansionLimit; ++P) {
+        auto [Namespace, Qualifier, Root] = std::move(Pending[P]);
+        const auto Key = std::make_pair(Root, canonicalNamespace(Namespace));
+        if (!Key.second ||
+            std::find(VisitedNamespaces.begin(), VisitedNamespaces.end(),
+                      Key) != VisitedNamespaces.end())
+          continue;
+        VisitedNamespaces.push_back(Key);
+        CXXScopeSpec SS;
+        SourceLocation Loc = S.getPreprocessor().getCodeCompletionLoc();
+        if (auto *Alias = dyn_cast<NamespaceAliasDecl>(Namespace))
+          SS.Extend(S.getASTContext(), Alias, Loc, Loc);
+        else if (auto *NS = dyn_cast<NamespaceDecl>(Namespace))
+          SS.Extend(S.getASTContext(), NS, Loc, Loc);
+        else
+          continue;
+
+        std::vector<CodeCompletionResult> QualifiedResults;
+        CodeCompletionContext QualifiedContext(CodeCompletionContext::CCC_Other);
+        Recorder->QualifiedResults = &QualifiedResults;
+        Recorder->QualifiedContext = &QualifiedContext;
+        S.CodeCompletion().CodeCompleteQualifiedId(
+            S.getCurScope(), SS, /*EnteringContext=*/false,
+            PrimaryContext.isUsingDeclaration(), QualType(),
+            PrimaryContext.getPreferredType());
+        Recorder->QualifiedResults = nullptr;
+        Recorder->QualifiedContext = nullptr;
+        if (QualifiedResults.empty())
+          continue;
+
+        Recorder->CCContext = QualifiedContext;
+        CCContextKind = QualifiedContext.getKind();
+        Filter.emplace("");
+        auto Ranked = mergeResults(QualifiedResults, SymbolSlab(), {});
+        for (const auto &Bundle : Ranked) {
+          for (const auto &Candidate : Bundle.first) {
+            if (!Candidate.SemaResult ||
+                Candidate.SemaResult->Kind !=
+                    CodeCompletionResult::RK_Declaration)
+              continue;
+            NamedDecl *Nested = namespaceDeclaration(
+                Candidate.SemaResult->getDeclaration());
+            if (!Nested)
+              continue;
+            if (Pending.size() == ExpansionLimit) {
+              ExpansionTruncated = true;
+              continue;
+            }
+            Pending.emplace_back(
+                Nested,
+                Qualifier + Recorder->getName(*Candidate.SemaResult).str() +
+                    "::",
+                Root);
+          }
+        }
+        auto Children = toCodeCompleteResult(Ranked);
+        for (auto &Child : Children.Completions) {
+          if (llvm::none_of(Child.Symbols, [](const auto &Symbol) {
+                return Symbol.IsType || Symbol.IsValue || Symbol.IsCallable;
+              }))
+            continue;
+          Child.RequiredQualifier = Qualifier;
+          Child.FilterText = Qualifier + Child.Name;
+          Expanded.push_back(std::move(Child));
+          if (Expanded.size() == ExpansionLimit) {
+            ExpansionTruncated = true;
+            break;
+          }
+        }
+      }
+      ExpansionTruncated |= P < Pending.size();
+      Recorder->CCContext = PrimaryContext;
+      CCContextKind = PrimaryKind;
+      Filter = std::move(PrimaryFilter);
+      if (!Expanded.empty()) {
+        bool Truncated = Opts.Limit &&
+                         Expanded.size() + Output.Completions.size() >
+                             Opts.Limit;
+        Expanded.insert(Expanded.end(),
+                        std::make_move_iterator(Output.Completions.begin()),
+                        std::make_move_iterator(Output.Completions.end()));
+        if (Truncated)
+          Expanded.resize(Opts.Limit);
+        Output.Completions = std::move(Expanded);
+        Output.HasMore |= ExpansionTruncated || Truncated;
+      }
+    }
+    populateSemanticGraph(Output);
+    if (Opts.IncludeAllSemaDeclarations) {
+      llvm::DenseSet<const CodeCompletionResult *> RankedDeclarations;
+      for (const auto &Bundle : Top)
+        for (const auto &Candidate : Bundle.first)
+          if (Candidate.SemaResult)
+            RankedDeclarations.insert(Candidate.SemaResult);
+      for (const auto &Result : Recorder->Results) {
+        // Ranked completions are already bounded by Limit. Bound the extra
+        // exact-Sema inventory too, so one completion response cannot freeze
+        // a browser while it is cloned and transferred to a worker.
+        if (Opts.Limit && Output.Completions.size() +
+                              Output.VisibleDeclarations.size() >= Opts.Limit)
+          break;
+        if (Result.Kind != CodeCompletionResult::RK_Declaration ||
+            RankedDeclarations.contains(&Result))
+          continue;
+        CompletionCandidate Candidate;
+        Candidate.SemaResult = &Result;
+        Candidate.Name = Recorder->getName(Result);
+        if (Candidate.Name.empty())
+          continue;
+        CodeCompletion Completion;
+        Completion.Name = std::string(Candidate.Name);
+        if (containsActiveMacroIdentifier(Completion.Name,
+                                          Recorder->CCSema->getPreprocessor()))
+          continue;
+        Completion.FilterText = Completion.Name;
+        Completion.Kind = toCompletionItemKind(Result, CCContextKind);
+        Completion.Origin = SymbolOrigin::AST;
+        Completion.CompletionTokenRange = ReplacedRange;
+        auto Symbol = semanticCompletionSymbol(
+            Candidate, &Recorder->CCSema->getASTContext(),
+            Recorder->CCSema);
+        if (Symbol.QualifiedName.empty() ||
+            !isMacroSafeSemanticSymbol(
+                Symbol, Recorder->CCSema->getPreprocessor()))
+          continue;
+        Completion.Scope = std::string(
+            splitQualifiedName(Symbol.QualifiedName).first);
+        Completion.Symbols.push_back(std::move(Symbol));
+        Output.VisibleDeclarations.push_back(std::move(Completion));
+      }
+    }
+    if (Opts.IncludeSemanticDetails) {
+      ASTContext &Ctx = Recorder->CCSema->getASTContext();
+      QualType Preferred = Recorder->CCContext.getPreferredType();
+      Output.PreferredType = printSemanticType(Preferred, Ctx);
+      Output.CanonicalPreferredType = printSemanticType(Preferred, Ctx, true);
+      Output.PreferredTypeInfo =
+          semanticTypeMetadata(Preferred, Ctx, Recorder->CCSema);
+      QualType Base = Recorder->CCContext.getBaseType();
+      Output.BaseType = printSemanticType(Base, Ctx);
+      Output.CanonicalBaseType = printSemanticType(Base, Ctx, true);
+      Output.BaseTypeInfo =
+          semanticTypeMetadata(Base, Ctx, Recorder->CCSema);
+      const DeclContext *DC = Recorder->CCSema->CurContext;
+      const FunctionDecl *EnclosingFunction = nullptr;
+      const CXXRecordDecl *EnclosingClass = nullptr;
+      for (; DC && (!EnclosingFunction || !EnclosingClass);
+           DC = DC->getParent()) {
+        if (!EnclosingFunction)
+          EnclosingFunction = dyn_cast<FunctionDecl>(DC);
+        if (!EnclosingClass)
+          EnclosingClass = dyn_cast<CXXRecordDecl>(DC);
+      }
+      if (EnclosingFunction) {
+        QualType Return = EnclosingFunction->getReturnType();
+        Output.EnclosingReturnType = printSemanticType(Return, Ctx);
+        Output.CanonicalEnclosingReturnType =
+            printSemanticType(Return, Ctx, true);
+        Output.EnclosingReturnTypeInfo =
+            semanticTypeMetadata(Return, Ctx, Recorder->CCSema);
+      }
+      if (EnclosingClass) {
+        QualType Class = Ctx.getRecordType(EnclosingClass);
+        Output.EnclosingClassType = printSemanticType(Class, Ctx);
+        Output.CanonicalEnclosingClassType =
+            printSemanticType(Class, Ctx, true);
+        Output.EnclosingClassTypeInfo =
+            semanticTypeMetadata(Class, Ctx, Recorder->CCSema);
+      }
+      QualType This = Recorder->CCSema->getCurrentThisType();
+      Output.ThisType = printSemanticType(This, Ctx);
+      Output.CanonicalThisType = printSemanticType(This, Ctx, true);
+      Output.ThisTypeInfo =
+          semanticTypeMetadata(This, Ctx, Recorder->CCSema);
+    }
+    return Output;
+  }
+
+  void populateSemanticGraph(CodeCompleteResult &Output) {
+    Output.SemanticGraphLimit = Opts.SemanticGraphLimit;
+    Output.SemanticGraphDepth = Opts.SemanticGraphDepth;
+    if (!Opts.IncludeAllSemaDeclarations ||
+        (!Opts.SemanticGraphLimit && !Opts.SemanticOperationLimit &&
+         !Opts.SemanticExpressionWitnessLimit))
+      return;
+
+    struct GraphCandidate {
+      CodeCompletionResult Result;
+      std::string Qualifier;
+      NestedNameSpecifier *QualifierNNS = nullptr;
+      unsigned SemanticPriority = 0;
+      bool IndexedForCompletion = false;
+      bool SourceSpelled = false;
+      bool Reserved = false;
+    };
+    struct NamespaceExpansion {
+      NamedDecl *Namespace;
+      std::string Qualifier;
+      NestedNameSpecifier *QualifierNNS;
+      unsigned Root;
+      unsigned Depth;
+    };
+    ASTContext &AST = Recorder->CCSema->getASTContext();
+    const SourceManager &SM = Recorder->CCSema->getSourceManager();
+    const size_t WorkLimit =
+        Opts.SemanticGraphLimit > std::numeric_limits<size_t>::max() / 8
+            ? std::numeric_limits<size_t>::max()
+            : Opts.SemanticGraphLimit * 8;
+    const size_t NamespaceWorkLimit =
+        std::min<size_t>(Opts.SemanticGraphLimit, 256);
+    std::vector<GraphCandidate> Candidates;
+    llvm::StringSet<> CandidateKeys;
+    llvm::SmallVector<NamespaceExpansion, 16> PublicPending;
+    llvm::SmallVector<NamespaceExpansion, 16> InternalPending;
+    llvm::SmallVector<std::pair<std::string, const NamespaceDecl *>, 16>
+        RootNamespaces;
+    unsigned NextRoot = 0;
+    size_t Work = 0;
+    bool WorkTruncated = false;
+
+    auto IsReserved = [&](const NamedDecl *D) {
+      return D && D->isReserved(AST.getLangOpts()) !=
+                      ReservedIdentifierStatus::NotReserved;
+    };
+    auto QualifierIsReserved = [](llvm::StringRef Qualifier) {
+      while (!Qualifier.empty()) {
+        auto [Component, Rest] = Qualifier.split("::");
+        if (Component.starts_with('_'))
+          return true;
+        Qualifier = Rest;
+      }
+      return false;
+    };
+    auto SemanticAtomPriority = [](const NamedDecl *D) {
+      // Values and aliases carry concrete types into the operation closure.
+      // Type declarations are the next strongest receiver roots; callable
+      // inventories are useful only after those atoms have survived bounds.
+      if (isa_and_nonnull<VarDecl, VarTemplateDecl, TypedefNameDecl,
+                         TypeAliasTemplateDecl>(D))
+        return 0u;
+      if (isa_and_nonnull<TypeDecl, ClassTemplateDecl, NamespaceDecl,
+                         NamespaceAliasDecl>(D))
+        return 1u;
+      if (isa_and_nonnull<FunctionDecl, FunctionTemplateDecl>(D))
+        return 2u;
+      return 3u;
+    };
+
+    auto ConsumeWork = [&]() -> bool {
+      if (Work == WorkLimit) {
+        WorkTruncated = true;
+        Output.SemanticGraphHasMore = true;
+        return false;
+      }
+      ++Work;
+      return true;
+    };
+    auto StoreResult = [&](const CodeCompletionResult &Result,
+                           llvm::StringRef Qualifier,
+                           NestedNameSpecifier *QualifierNNS) {
+      if (Result.Kind != CodeCompletionResult::RK_Declaration)
+        return;
+      llvm::StringRef Name = Recorder->getName(Result);
+      if (Name.empty())
+        return;
+      std::string Key = (Qualifier + Name).str();
+      Key.push_back('\0');
+      Key.append(getSymbolID(Result, SM).str());
+      if (!CandidateKeys.insert(Key).second)
+        return;
+      const auto *D = dyn_cast_or_null<NamedDecl>(Result.getDeclaration());
+      Candidates.push_back(
+          {Result, std::string(Qualifier), QualifierNNS,
+           SemanticAtomPriority(D),
+           D && isIndexedForCodeCompletion(*D, AST),
+           D && !D->isImplicit() && D->getLocation().isValid(),
+           IsReserved(D) || QualifierIsReserved(Qualifier)});
+    };
+    auto AddResult = [&](const CodeCompletionResult &Result,
+                         llvm::StringRef Qualifier,
+                         NestedNameSpecifier *QualifierNNS) -> bool {
+      if (!ConsumeWork())
+        return false;
+      StoreResult(Result, Qualifier, QualifierNNS);
+      return true;
+    };
+    auto QueueNamespaceContents = [&](NamedDecl *D, std::string Q,
+                                      NestedNameSpecifier *NNS,
+                                      unsigned Root, unsigned NextDepth) {
+        const auto *NS = dyn_cast_or_null<NamespaceDecl>(D);
+        // An inline/anonymous namespace does not contribute a spelling
+        // component. In particular, an implementation-reserved ABI namespace
+        // underneath a public namespace contains public atoms such as aliases;
+        // route it with the public qualifier rather than starving it behind
+        // unrelated nested namespace inventory.
+        const bool TransparentNamespace =
+            NS && (NS->isAnonymousNamespace() || NS->isInline());
+        auto &Pending = IsReserved(D) && !TransparentNamespace
+                            ? InternalPending
+                            : PublicPending;
+        Pending.push_back({D, std::move(Q), NNS, Root, NextDepth});
+    };
+    auto QueueNamespace = [&](NamedDecl *Namespace, llvm::StringRef Qualifier,
+                              NestedNameSpecifier *QualifierNNS,
+                              unsigned Root, unsigned Depth) {
+      if (auto *Alias = dyn_cast_or_null<NamespaceAliasDecl>(Namespace)) {
+        if (!Alias->getName().empty())
+          QueueNamespaceContents(
+              Alias, (Qualifier + Alias->getName() + "::").str(),
+              NestedNameSpecifier::Create(AST, QualifierNNS, Alias), Root,
+              Depth + 1);
+        return;
+      }
+      auto *NS = dyn_cast_or_null<NamespaceDecl>(Namespace);
+      if (!NS)
+        return;
+      if (NS->isAnonymousNamespace() || NS->isInline())
+        QueueNamespaceContents(NS, std::string(Qualifier), QualifierNNS,
+                               Root, Depth);
+      else if (!NS->getName().empty())
+        QueueNamespaceContents(
+            NS, (Qualifier + NS->getName() + "::").str(),
+            NestedNameSpecifier::Create(AST, QualifierNNS, NS), Root,
+            Depth + 1);
+    };
+    auto AddRootNamespace = [&](const CodeCompletionResult &Result) {
+      NamedDecl *Namespace = namespaceDeclaration(Result.getDeclaration());
+      llvm::StringRef Name = Recorder->getName(Result);
+      const NamespaceDecl *Canonical = canonicalNamespace(Namespace);
+      if (!Canonical || Name.empty())
+        return;
+      std::string Qualifier = (Name + "::").str();
+      const auto Key = std::make_pair(Qualifier, Canonical);
+      if (std::find(RootNamespaces.begin(), RootNamespaces.end(), Key) !=
+          RootNamespaces.end())
+        return;
+      RootNamespaces.push_back(Key);
+      auto &Pending = IsReserved(Namespace) ? InternalPending : PublicPending;
+      NestedNameSpecifier *NNS = nullptr;
+      if (auto *Alias = dyn_cast<NamespaceAliasDecl>(Namespace))
+        NNS = NestedNameSpecifier::Create(AST, nullptr, Alias);
+      else if (auto *NS = dyn_cast<NamespaceDecl>(Namespace))
+        NNS = NestedNameSpecifier::Create(AST, nullptr, NS);
+      Pending.push_back(
+          {Namespace, std::move(Qualifier), NNS, NextRoot++, 0});
+    };
+
+    for (const auto &Result : Recorder->Results) {
+      if (!AddResult(Result, "", nullptr))
+        break;
+      AddRootNamespace(Result);
+    }
+
+    llvm::SmallVector<std::pair<unsigned, const NamespaceDecl *>, 32>
+        VisitedNamespaces;
+    size_t PublicP = 0;
+    size_t InternalP = 0;
+    size_t ExpandedNamespaces = 0;
+    while (!WorkTruncated &&
+           (PublicP < PublicPending.size() ||
+            InternalP < InternalPending.size())) {
+      NamespaceExpansion Expansion =
+          PublicP < PublicPending.size()
+              ? std::move(PublicPending[PublicP++])
+              : std::move(InternalPending[InternalP++]);
+      auto [Namespace, Qualifier, QualifierNNS, Root, Depth] =
+          std::move(Expansion);
+      if (Depth >= Opts.SemanticGraphDepth)
+        continue;
+      const NamespaceDecl *Canonical = canonicalNamespace(Namespace);
+      if (!Canonical) {
+        Output.SemanticGraphHasMore = true;
+        continue;
+      }
+      const auto Key = std::make_pair(Root, Canonical);
+      if (std::find(VisitedNamespaces.begin(), VisitedNamespaces.end(), Key) !=
+          VisitedNamespaces.end())
+        continue;
+      if (ExpandedNamespaces++ == NamespaceWorkLimit) {
+        Output.SemanticGraphHasMore = true;
+        break;
+      }
+      VisitedNamespaces.push_back(Key);
+
+      // Merge all redeclaration contexts before applying the work bound.
+      // Headers repeatedly reopen namespaces, so exhausting the earliest
+      // context first would make semantic retention depend on include order.
+      // Inline/transparent contexts share the same visible qualifier and can
+      // be merged into this lane as well.
+      llvm::SmallVector<const DeclContext *, 32> Contexts;
+      for (const NamespaceDecl *Redecl : Canonical->redecls())
+        Contexts.push_back(Redecl);
+      llvm::SmallVector<Decl *, 1024> OrderedDecls;
+      for (size_t C = 0; C < Contexts.size(); ++C) {
+        const DeclContext *Context = Contexts[C];
+        for (Decl *D : Context->decls()) {
+          OrderedDecls.push_back(D);
+          if (const auto *NS = dyn_cast<NamespaceDecl>(D)) {
+            if (NS->isAnonymousNamespace() || NS->isInline())
+              Contexts.push_back(NS);
+          } else if (const auto *Nested = dyn_cast<DeclContext>(D)) {
+            if (Nested->isTransparentContext())
+              Contexts.push_back(Nested);
+          }
+        }
+      }
+      auto NamespaceAtomPriority = [&](const Decl *D) {
+        // Concrete value and alias atoms are exact namespace facts and are
+        // the most useful operation-closure roots. Visit them before large
+        // template/function inventories so a bounded graph retains objects
+        // and the concrete types denoted by aliases. Namespace routing and
+        // using declarations follow, then progressively more expansive
+        // declaration families.
+        if (isa<VarDecl, VarTemplateDecl, TypedefNameDecl,
+                TypeAliasTemplateDecl>(D))
+          return 0u;
+        if (isa<UsingDirectiveDecl, BaseUsingDecl, UsingShadowDecl,
+                NamespaceDecl, NamespaceAliasDecl>(D))
+          return 1u;
+        if (isa<TemplateDecl>(D))
+          return 2u;
+        if (isa<TypeDecl>(D))
+          return 3u;
+        if (isa<FunctionDecl>(D))
+          return 4u;
+        return 5u;
+      };
+      std::stable_sort(OrderedDecls.begin(), OrderedDecls.end(),
+                       [&](const Decl *L, const Decl *R) {
+                         const auto IsReservedDecl = [&](const Decl *D) {
+                           const auto *Named = dyn_cast<NamedDecl>(D);
+                           return Named && IsReserved(Named);
+                         };
+                         return std::tuple(NamespaceAtomPriority(L),
+                                           IsReservedDecl(L)) <
+                                std::tuple(NamespaceAtomPriority(R),
+                                           IsReservedDecl(R));
+      });
+      for (Decl *D : OrderedDecls) {
+        if (!ConsumeWork())
+          break;
+        if (auto *UsingDirective = dyn_cast<UsingDirectiveDecl>(D)) {
+          if (auto *Target = UsingDirective->getNominatedNamespace())
+            // Qualified lookup through the current route considers nominated
+            // namespaces. Traverse their contents without replacing the route
+            // by the physical namespace name.
+            QueueNamespaceContents(Target, Qualifier, QualifierNNS, Root,
+                                   Depth);
+          continue;
+        }
+        if (auto *Using = dyn_cast<BaseUsingDecl>(D)) {
+          for (UsingShadowDecl *Shadow : Using->shadows()) {
+            if (!ConsumeWork())
+              break;
+            const auto *Target = Shadow->getTargetDecl();
+            if (!Target || Target->isInvalidDecl())
+              continue;
+            CodeCompletionResult Result(Target, CCP_Declaration);
+            StoreResult(Result, Qualifier, QualifierNNS);
+            QueueNamespace(const_cast<NamedDecl *>(Target), Qualifier,
+                           QualifierNNS, Root, Depth);
+          }
+          continue;
+        }
+        if (auto *Shadow = dyn_cast<UsingShadowDecl>(D)) {
+          const auto *Target = Shadow->getTargetDecl();
+          if (!Target || Target->isInvalidDecl())
+            continue;
+          CodeCompletionResult Result(Target, CCP_Declaration);
+          StoreResult(Result, Qualifier, QualifierNNS);
+          QueueNamespace(const_cast<NamedDecl *>(Target), Qualifier,
+                         QualifierNNS, Root, Depth);
+          continue;
+        }
+        if (auto *Named = dyn_cast<NamedDecl>(D)) {
+          if (Named->isInvalidDecl() || Named->isImplicit())
+            continue;
+          CodeCompletionResult Result(Named, CCP_Declaration);
+          StoreResult(Result, Qualifier, QualifierNNS);
+          QueueNamespace(Named, Qualifier, QualifierNNS, Root, Depth);
+          continue;
+        }
+      }
+    }
+    if (WorkTruncated || PublicP < PublicPending.size() ||
+        InternalP < InternalPending.size())
+      Output.SemanticGraphHasMore = true;
+
+    // Namespace traversal above intentionally visits transparent declaration
+    // contexts.  That is necessary for inline namespaces, linkage specs, and
+    // unscoped-enum injection, but DeclContext transparency by itself is not
+    // proof that `Qualifier + Name` denotes the declaration.  In particular,
+    // declarations nested in implementation helpers must not masquerade as a
+    // direct child of a public namespace.  Re-run ordinary lookup through the
+    // exact recorded nested-name-specifier and retain only declarations that
+    // occur in that lookup set.  Resolving aliases/using shadows to their
+    // underlying declaration preserves valid alias, using, and inline routes.
+    auto CanonicalLookupTarget = [](const NamedDecl *D) -> const NamedDecl * {
+      if (!D)
+        return nullptr;
+      return cast<NamedDecl>(
+          D->getUnderlyingDecl()->getCanonicalDecl());
+    };
+    using ExactRouteKey =
+        std::pair<const NestedNameSpecifier *, DeclarationName>;
+    llvm::DenseMap<ExactRouteKey,
+                   llvm::SmallVector<const NamedDecl *, 4>>
+        ExactRouteLookupCache;
+    auto IsExactGraphRoute = [&](const GraphCandidate &Graph) {
+      const auto *Target =
+          dyn_cast_or_null<NamedDecl>(Graph.Result.getDeclaration());
+      if (!Target || Target->getDeclName().isEmpty())
+        return false;
+      if (Graph.Qualifier.empty() != (Graph.QualifierNNS == nullptr))
+        return false;
+
+      Sema &S = *Recorder->CCSema;
+      SourceLocation Loc = S.getPreprocessor().getCodeCompletionLoc();
+      if (Loc.isInvalid())
+        return false;
+      auto [It, Inserted] = ExactRouteLookupCache.try_emplace(
+          ExactRouteKey{Graph.QualifierNNS, Target->getDeclName()});
+      if (Inserted) {
+        CXXScopeSpec SS;
+        if (Graph.QualifierNNS)
+          SS.MakeTrivial(AST, Graph.QualifierNNS, SourceRange(Loc, Loc));
+        LookupResult Found(S, Target->getDeclName(), Loc,
+                           Sema::LookupOrdinaryName);
+        S.LookupParsedName(Found, S.getCurScope(), &SS, QualType(), false,
+                           false);
+        if (!Found.isAmbiguous())
+          for (const NamedDecl *D : Found)
+            if (const NamedDecl *Canonical = CanonicalLookupTarget(D))
+              if (!llvm::is_contained(It->second, Canonical))
+                It->second.push_back(Canonical);
+      }
+      const NamedDecl *CanonicalTarget = CanonicalLookupTarget(Target);
+      return llvm::is_contained(It->second, CanonicalTarget);
+    };
+    Candidates.erase(
+        std::remove_if(Candidates.begin(), Candidates.end(),
+                       [&](const GraphCandidate &Graph) {
+                         return !IsExactGraphRoute(Graph);
+                       }),
+        Candidates.end());
+
+    llvm::DenseSet<SymbolID> CandidateIDs;
+    for (const auto &Candidate : Candidates) {
+      SymbolID ID = getSymbolID(Candidate.Result, SM);
+      if (ID != SymbolID())
+        CandidateIDs.insert(ID);
+    }
+    llvm::DenseSet<SymbolID> IndexedIDs;
+    if (Opts.Index && !CandidateIDs.empty()) {
+      LookupRequest Request;
+      Request.IDs = std::move(CandidateIDs);
+      Opts.Index->lookup(Request, [&](const Symbol &S) {
+        if (S.Flags & Symbol::IndexedForCodeCompletion)
+          IndexedIDs.insert(S.ID);
+      });
+    }
+
+    // Match clang's own index eligibility before falling back to all exact
+    // Sema declarations. Within each group prefer names users can spell over
+    // implementation-reserved names. This is independent of whether the
+    // asynchronous index has warmed, so cold and warm graphs remain stable.
+    std::stable_sort(Candidates.begin(), Candidates.end(),
+                     [](const GraphCandidate &L, const GraphCandidate &R) {
+                       return std::tuple(L.SemanticPriority,
+                                         !L.IndexedForCompletion, L.Reserved,
+                                         !L.SourceSpelled) <
+                              std::tuple(R.SemanticPriority,
+                                         !R.IndexedForCompletion, R.Reserved,
+                                         !R.SourceSpelled);
+                     });
+
+    Output.SemanticOperationLimit = Opts.SemanticOperationLimit;
+    Output.SemanticOperationDepth = Opts.SemanticOperationDepth;
+    Output.SemanticExpressionWitnessLimit =
+        Opts.SemanticExpressionWitnessLimit;
+    Output.SemanticCallWitnessLimit = Opts.SemanticCallWitnessLimit;
+    Output.SemanticCallWitnessMaxArity = Opts.SemanticCallWitnessMaxArity;
+    llvm::SmallVector<QualType, 8> ExpressionResultTypeSeeds;
+    if (Opts.SemanticExpressionWitnessLimit) {
+      // This inventory is a deterministic finite prefix of C++'s open-ended
+      // type/expression space. Successful probes are authoritative; absence is
+      // deliberately reported as incomplete.
+      Output.SemanticExpressionWitnessesHaveMore = true;
+      constexpr size_t TypeLimit = 64;
+      constexpr size_t ProfileLimit = 48;
+      constexpr size_t TaskLimit = 256;
+      llvm::SmallVector<QualType, TypeLimit> ExpressionTypes;
+      llvm::SmallVector<SemanticWitnessArgumentProfile, ProfileLimit>
+          ExpressionProfiles;
+      llvm::StringSet<> SeenExpressionTypes;
+      llvm::StringSet<> SeenExpressionProfiles;
+
+      auto AddExpressionType = [&](QualType Type) {
+        if (Type.isNull() || Type->isDependentType() ||
+            Type->isInstantiationDependentType() || Type->isUndeducedType() ||
+            Type->containsUnexpandedParameterPack() ||
+            Type->isVariablyModifiedType() ||
+            !isSourceSpellableType(Type, AST) ||
+            !isSemanticTypeAccessible(Type, *Recorder->CCSema))
+          return;
+        auto Info = semanticTypeMetadata(Type, AST);
+        std::string Spelling = printSemanticType(Type, AST);
+        if (Info.CanonicalID.empty() || Spelling.empty())
+          return;
+        std::string Key = Info.CanonicalID;
+        Key.push_back('\0');
+        Key.append(Spelling);
+        if (!SeenExpressionTypes.insert(Key).second)
+          return;
+        if (ExpressionTypes.size() == TypeLimit)
+          return;
+        ExpressionTypes.push_back(Type);
+      };
+      auto AddExpressionProfile = [&](QualType Type, ExprValueKind Kind) {
+        if (Type.isNull())
+          return;
+        Type = Type.getNonReferenceType();
+        if (Type.isNull() || Type->isDependentType() ||
+            Type->isInstantiationDependentType() || Type->isUndeducedType() ||
+            Type->containsUnexpandedParameterPack() ||
+            Type->isVariablyModifiedType() || Type->isVoidType() ||
+            (!Type->isObjectType() && !Type->isFunctionType()))
+          return;
+        if ((Type->isArrayType() || Type->isFunctionType()) &&
+            Kind != VK_LValue)
+          return;
+        auto Info = semanticTypeMetadata(Type, AST);
+        if (Info.CanonicalID.empty())
+          return;
+        std::string Key = Info.CanonicalID;
+        Key.push_back('\0');
+        Key.append(semanticValueCategory(Kind));
+        if (!SeenExpressionProfiles.insert(Key).second)
+          return;
+        if (ExpressionProfiles.size() == ProfileLimit)
+          return;
+        ExpressionProfiles.push_back({SemanticWitnessArgumentKind::Opaque,
+                                      Type, Kind, OK_Ordinary});
+      };
+      auto AddExpressionDeclaration = [&](const NamedDecl *Named,
+                                          bool AddValue) {
+        while (const auto *Shadow = dyn_cast_or_null<UsingShadowDecl>(Named))
+          Named = Shadow->getTargetDecl();
+        if (!Named || Named->isInvalidDecl() || IsReserved(Named))
+          return;
+        if (const auto *Value = dyn_cast<ValueDecl>(Named)) {
+          QualType Type = Value->getType();
+          AddExpressionType(Type);
+          if (AddValue) {
+            if (const auto *Field = dyn_cast<FieldDecl>(Value))
+              if (Field->isBitField())
+                return;
+            if (const auto *Method = dyn_cast<CXXMethodDecl>(Value))
+              if (!Method->isStatic())
+                return;
+            AddExpressionProfile(
+                Type, isa<EnumConstantDecl>(Value) ? VK_PRValue : VK_LValue);
+          }
+        }
+        if (const auto *Alias = dyn_cast<TypedefNameDecl>(Named)) {
+          AddExpressionType(AST.getTypeDeclType(Alias));
+          AddExpressionType(Alias->getUnderlyingType());
+        } else if (const auto *Type = dyn_cast<TypeDecl>(Named)) {
+          AddExpressionType(AST.getTypeDeclType(Type));
+        }
+        if (const auto *ClassTemplate = dyn_cast<ClassTemplateDecl>(Named))
+          for (const ClassTemplateSpecializationDecl *Specialization :
+               ClassTemplate->specializations())
+            AddExpressionType(AST.getRecordType(Specialization));
+        if (const auto *VariableTemplate = dyn_cast<VarTemplateDecl>(Named))
+          for (const VarTemplateSpecializationDecl *Specialization :
+               VariableTemplate->specializations()) {
+            AddExpressionType(Specialization->getType());
+            if (AddValue)
+              AddExpressionProfile(Specialization->getType(), VK_LValue);
+          }
+      };
+      auto AddStandardExpressionTypeShapes = [&] {
+        llvm::SmallVector<QualType, TypeLimit> ExactTypeSeeds(ExpressionTypes);
+        for (QualType Seed : ExactTypeSeeds) {
+          QualType Value = Seed.getNonReferenceType();
+          if (Value.isNull())
+            continue;
+          if (!Value->isPointerType() && !Value->isArrayType() &&
+              (Value->isObjectType() || Value->isFunctionType() ||
+               Value->isVoidType())) {
+            AddExpressionType(AST.getPointerType(Value));
+            if (Value->isObjectType() && !Value->isFunctionType())
+              AddExpressionType(AST.getPointerType(Value.withConst()));
+          }
+          if (Value.isReferenceable()) {
+            AddExpressionType(AST.getLValueReferenceType(Value));
+            AddExpressionType(AST.getRValueReferenceType(Value));
+          }
+        }
+      };
+
+      // Seed main-file types before broad completion/index declarations can
+      // fill the type bound. Values are retained for a second pass below: the
+      // exact visible-value profiles must remain the first operand profiles.
+      llvm::SmallVector<const DeclContext *, 16> ExpressionSourceContexts;
+      llvm::SmallVector<const NamedDecl *, 128> ExpressionSourceDeclarations;
+      ExpressionSourceContexts.push_back(AST.getTranslationUnitDecl());
+      const size_t SourceWorkLimit = std::min<size_t>(
+          std::max<size_t>(64, Opts.SemanticExpressionWitnessLimit * 8), 512);
+      size_t SourceWork = 0;
+      for (size_t I = 0; I < ExpressionSourceContexts.size() &&
+                         SourceWork < SourceWorkLimit;
+           ++I) {
+        for (Decl *D : ExpressionSourceContexts[I]->decls()) {
+          if (SourceWork == SourceWorkLimit)
+            break;
+          if (!SM.isWrittenInMainFile(SM.getExpansionLoc(D->getLocation())))
+            continue;
+          ++SourceWork;
+          if (const auto *Named = dyn_cast<NamedDecl>(D)) {
+            ExpressionSourceDeclarations.push_back(Named);
+            AddExpressionDeclaration(Named, false);
+          }
+          if (const auto *Nested = dyn_cast<DeclContext>(D))
+            ExpressionSourceContexts.push_back(Nested);
+        }
+      }
+      // Reserve standard pointer/reference/cv shapes for exact main-file
+      // types before broad visible and graph declarations can fill TypeLimit.
+      // This is what keeps a source `Derived*` target paired with a visible
+      // `Base*` operand under standard-library completion noise.
+      AddStandardExpressionTypeShapes();
+
+      // Main-file values are the most relevant exact operand expressions and
+      // must not be displaced by a broad completion inventory. Unlike type-id
+      // targets, these profiles may have unnamed/local static types: the
+      // grammar can still route their exact declaration expressions.
+      for (const NamedDecl *Named : ExpressionSourceDeclarations)
+        if (isa<ValueDecl>(Named))
+          AddExpressionDeclaration(Named, true);
+      // Other exact declarations visible at the cursor remain authoritative
+      // fallback operands after the bounded source inventory.
+      for (const CodeCompletionResult &Result : Recorder->Results)
+        if (Result.Kind == CodeCompletionResult::RK_Declaration)
+          AddExpressionDeclaration(
+              dyn_cast_or_null<NamedDecl>(Result.getDeclaration()), true);
+      for (const auto &Graph : Candidates)
+        AddExpressionDeclaration(
+            dyn_cast_or_null<NamedDecl>(Graph.Result.getDeclaration()), true);
+
+      // Context types are exact even if their declarations did not occur in a
+      // completion result. They are type targets, not invented expressions.
+      for (const DeclContext *DC = Recorder->CCSema->CurContext; DC;
+           DC = DC->getParent()) {
+        if (const auto *Function = dyn_cast<FunctionDecl>(DC))
+          AddExpressionType(Function->getReturnType());
+        if (const auto *Record = dyn_cast<CXXRecordDecl>(DC))
+          AddExpressionType(AST.getRecordType(Record));
+      }
+      AddExpressionType(Recorder->CCSema->getCurrentThisType());
+
+      // Derive only standard pointer/reference/cv shapes from the sealed exact
+      // source seeds above. No spelling is parsed or guessed by the producer.
+      AddStandardExpressionTypeShapes();
+      // A generic language seed guarantees that a successful early typeid
+      // probe can expose std::type_info even when no source value has that
+      // static type. Other builtins remain low-priority fallback targets.
+      AddExpressionType(AST.IntTy);
+      AddExpressionType(AST.DoubleTy);
+      AddExpressionType(AST.CharTy);
+      AddExpressionType(AST.BoolTy);
+
+      // Exact visible profiles were inserted first. Fill remaining slots with
+      // bounded category shapes from concrete source-spellable types.
+      for (QualType Type : ExpressionTypes) {
+        QualType Value = Type.getNonReferenceType();
+        AddExpressionProfile(Value, VK_LValue);
+        AddExpressionProfile(Value, VK_PRValue);
+        AddExpressionProfile(Value, VK_XValue);
+      }
+
+      struct CastTask {
+        QualType Target;
+        SemanticWitnessArgumentProfile Operand;
+      };
+      llvm::SmallVector<CastTask, TaskLimit> PreferredDynamicTasks;
+      llvm::SmallVector<CastTask, TaskLimit> FallbackDynamicTasks;
+      llvm::SmallVector<CastTask, TaskLimit> ReinterpretTasks;
+      auto AddCastTask = [](auto &Tasks, QualType Target,
+                            const SemanticWitnessArgumentProfile &Operand) {
+        if (Tasks.size() != TaskLimit)
+          Tasks.push_back({Target, Operand});
+      };
+      auto DynamicRecord = [](QualType Type) -> const CXXRecordDecl * {
+        Type = Type.getNonReferenceType();
+        if (const auto *Pointer = Type->getAs<PointerType>())
+          Type = Pointer->getPointeeType();
+        const auto *Record = Type->getAsCXXRecordDecl();
+        return Record ? Record->getDefinition() : nullptr;
+      };
+      auto IsStrictRecordDowncast = [&](QualType Target, QualType Source) {
+        const CXXRecordDecl *TargetRecord = DynamicRecord(Target);
+        const CXXRecordDecl *SourceRecord = DynamicRecord(Source);
+        return TargetRecord && SourceRecord &&
+               TargetRecord->getCanonicalDecl() !=
+                   SourceRecord->getCanonicalDecl() &&
+               TargetRecord->isDerivedFrom(SourceRecord);
+      };
+      // Operand-major order tries every compatible target for the strongest
+      // exact visible value before advancing into fallback categories. Strict
+      // record downcasts form a small high-value lane ahead of identity and
+      // upcast work; without it, a broad type inventory can exhaust the
+      // bounded probe prefix before reaching the defining dynamic_cast use.
+      for (const auto &Operand : ExpressionProfiles) {
+        QualType Source = Operand.Type.getNonReferenceType();
+        for (QualType Target : ExpressionTypes) {
+          const bool TargetPointer = Target->isPointerType();
+          const bool TargetReference = Target->isReferenceType();
+          if ((TargetPointer && Source->isPointerType()) ||
+              (TargetReference && Source->isRecordType() &&
+               Operand.ValueKind != VK_PRValue)) {
+            auto &Tasks = IsStrictRecordDowncast(Target, Source)
+                              ? PreferredDynamicTasks
+                              : FallbackDynamicTasks;
+            AddCastTask(Tasks, Target, Operand);
+          }
+
+          const bool ReinterpretTarget =
+              TargetPointer || TargetReference || Target->isIntegralType(AST) ||
+              Target->isEnumeralType() || Target->isMemberPointerType();
+          const bool ReinterpretRecordGlvalue =
+              TargetReference && Source->isRecordType() &&
+              Operand.ObjectKind == OK_Ordinary &&
+              Operand.ValueKind != VK_PRValue;
+          const bool ReinterpretSource =
+              Source->isPointerType() || Source->isIntegralType(AST) ||
+              Source->isEnumeralType() || Source->isFunctionType() ||
+              Source->isArrayType() || Source->isMemberPointerType() ||
+              ReinterpretRecordGlvalue;
+          if (ReinterpretTarget && ReinterpretSource &&
+              (!TargetReference || Operand.ValueKind != VK_PRValue))
+            AddCastTask(ReinterpretTasks, Target, Operand);
+        }
+      }
+      llvm::SmallVector<CastTask, TaskLimit> DynamicTasks;
+      DynamicTasks.append(PreferredDynamicTasks.begin(),
+                          PreferredDynamicTasks.end());
+      for (const CastTask &Task : FallbackDynamicTasks) {
+        if (DynamicTasks.size() == TaskLimit)
+          break;
+        DynamicTasks.push_back(Task);
+      }
+
+      llvm::SmallVector<SemanticCompletionExpressionWitness, 16>
+          WitnessLanes[4];
+      llvm::StringSet<> SeenExpressionWitnesses;
+      llvm::StringSet<> SeenExpressionResultTypes;
+      auto StoreExpressionWitness = [&](unsigned Family,
+                                        SemanticExpressionProbe Probe) {
+        const auto &Witness = Probe.Witness;
+        std::string Key = Witness.Syntax;
+        Key.push_back('\0');
+        Key.append(Witness.TypeOperand.Type);
+        Key.push_back('\0');
+        Key.append(Witness.ExpressionOperand.TypeInfo.CanonicalID);
+        Key.push_back('\0');
+        Key.append(Witness.ExpressionOperand.ValueCategory);
+        Key.push_back('\0');
+        Key.append(Witness.Result.TypeInfo.CanonicalID);
+        Key.push_back('\0');
+        Key.append(Witness.Result.ValueCategory);
+        if (!SeenExpressionWitnesses.insert(Key).second)
+          return;
+        WitnessLanes[Family].push_back(std::move(Probe.Witness));
+        auto ResultInfo = semanticTypeMetadata(Probe.ResultType, AST);
+        if (!ResultInfo.CanonicalID.empty() &&
+            SeenExpressionResultTypes.insert(ResultInfo.CanonicalID).second)
+          ExpressionResultTypeSeeds.push_back(Probe.ResultType);
+      };
+
+      const size_t AttemptLimit = std::min<size_t>(
+          std::max<size_t>(4, Opts.SemanticExpressionWitnessLimit * 2), 128);
+      size_t Attempts = 0;
+      // This probe deliberately precedes all operation traversal. On success,
+      // const std::type_info is an owner root even if expression output later
+      // truncates the typeid lane.
+      ++Attempts;
+      if (auto Typeid = probeSemanticTypeidType(*Recorder->CCSema, AST.IntTy))
+        StoreExpressionWitness(/*typeidType=*/3, std::move(*Typeid));
+
+      size_t NextDynamic = 0;
+      size_t NextReinterpret = 0;
+      size_t NextTypeidExpression = 0;
+      size_t NextTypeidType = 0;
+      bool ProbeProgress = true;
+      while (ProbeProgress && Attempts < AttemptLimit) {
+        ProbeProgress = false;
+        for (unsigned Family = 0; Family != 4 && Attempts < AttemptLimit;
+             ++Family) {
+          std::optional<SemanticExpressionProbe> Probe;
+          if (Family == 0 && NextDynamic < DynamicTasks.size()) {
+            const CastTask &Task = DynamicTasks[NextDynamic++];
+            ++Attempts;
+            Probe = probeSemanticNamedCast(*Recorder->CCSema,
+                                           tok::kw_dynamic_cast, Task.Target,
+                                           Task.Operand);
+          } else if (Family == 1 &&
+                     NextReinterpret < ReinterpretTasks.size()) {
+            const CastTask &Task = ReinterpretTasks[NextReinterpret++];
+            ++Attempts;
+            Probe = probeSemanticNamedCast(*Recorder->CCSema,
+                                           tok::kw_reinterpret_cast,
+                                           Task.Target, Task.Operand);
+          } else if (Family == 2 &&
+                     NextTypeidExpression < ExpressionProfiles.size()) {
+            ++Attempts;
+            Probe = probeSemanticTypeidExpression(
+                *Recorder->CCSema,
+                ExpressionProfiles[NextTypeidExpression++]);
+          } else if (Family == 3 &&
+                     NextTypeidType < ExpressionTypes.size()) {
+            QualType Type = ExpressionTypes[NextTypeidType++];
+            ++Attempts;
+            Probe = probeSemanticTypeidType(*Recorder->CCSema, Type);
+          } else {
+            continue;
+          }
+          ProbeProgress = true;
+          if (Probe)
+            StoreExpressionWitness(Family, std::move(*Probe));
+        }
+      }
