+bool isSemanticForwardingReference(QualType Type,
+                                   const FunctionTemplateDecl &Template) {
+  if (Type.isNull())
+    return false;
+  if (const auto *Expansion = Type->getAs<PackExpansionType>())
+    Type = Expansion->getPattern();
+  const auto *Reference = Type->getAs<RValueReferenceType>();
+  if (!Reference || Reference->getPointeeType().getQualifiers())
+    return false;
