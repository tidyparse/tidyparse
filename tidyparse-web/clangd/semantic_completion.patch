+llvm::json::Object semanticTypeInfoJSON(
+    const SemanticCompletionParameter::TypeMetadata &T) {
+  llvm::json::Object Result{
+      {"id", T.ID},
+      {"canonicalId", T.CanonicalID},
+      {"valueCanonicalId", T.ValueCanonicalID},
+      {"kind", T.Kind},
+      {"isDependent", T.IsDependent},
+      {"isInstantiationDependent", T.IsInstantiationDependent},
+      {"isSourceSpellable", T.IsSourceSpellable},
+      {"isComplete", T.IsComplete},
+      {"isConst", T.IsConst},
+      {"isVolatile", T.IsVolatile}};
+  if (!T.PointeeCanonicalID.empty()) {
+    Result["pointeeCanonicalId"] = T.PointeeCanonicalID;
+    Result["pointeeIsConst"] = T.PointeeIsConst;
+    Result["pointeeIsVolatile"] = T.PointeeIsVolatile;
+  }
+  if (!T.ElementCanonicalID.empty()) {
+    Result["elementCanonicalId"] = T.ElementCanonicalID;
+    Result["elementIsConst"] = T.ElementIsConst;
+    Result["elementIsVolatile"] = T.ElementIsVolatile;
+    Result["isIncompleteArray"] = T.IsIncompleteArray;
+    if (!T.ArrayBound.empty())
+      Result["arrayBound"] = T.ArrayBound;
+  }
+  if (T.IsDefaultConstructible)
+    Result["isDefaultConstructible"] = *T.IsDefaultConstructible;
+  return Result;
+}
+
+llvm::json::Object semanticExpressionProfileJSON(
+    const SemanticCompletionExpressionProfile &P) {
+  llvm::json::Object Result{{"kind", P.Kind},
+                            {"type", P.Type},
+                            {"canonicalType", P.CanonicalType},
+                            {"valueCategory", P.ValueCategory},
+                            {"objectKind", P.ObjectKind}};
+  if (!P.Spelling.empty())
+    Result["spelling"] = P.Spelling;
+  if (P.TypeInfo.Present)
+    Result["typeInfo"] = semanticTypeInfoJSON(P.TypeInfo);
+  return Result;
+}
