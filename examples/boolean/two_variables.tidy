START -> E_AND = E_AND | E_P = E_P | E_Q = E_Q | E_OR = E_OR

E_P -> p
E_P -> ( E_P & E_P ) | ( E_P & E_OR ) | ( E_OR & E_P )
E_P -> ( E_P v E_P ) | ( E_P v E_AND ) | ( E_AND v E_P )

E_Q -> q
E_Q -> ( E_Q & E_Q ) | ( E_Q & E_OR ) | ( E_OR & E_Q )
E_Q -> ( E_Q v E_Q ) | ( E_Q v E_AND ) | ( E_AND v E_Q )

E_AND -> ( E_AND & E_AND ) | ( E_AND & E_P ) | ( E_AND & E_Q ) | ( E_AND & E_OR )
E_AND -> ( E_P & E_AND ) | ( E_Q & E_AND ) | ( E_OR & E_AND )
E_AND -> ( E_P & E_Q ) | ( E_Q & E_P )
E_AND -> ( E_AND v E_AND )

E_OR -> ( E_OR & E_OR )
E_OR -> ( E_OR v E_OR ) | ( E_OR v E_P ) | ( E_OR v E_Q ) | ( E_OR v E_AND )
E_OR -> ( E_P v E_OR ) | ( E_Q v E_OR ) | ( E_AND v E_OR )
E_OR -> ( E_P v E_Q ) | ( E_Q v E_P )

